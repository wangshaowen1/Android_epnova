    <style name="NullAnimation" parent="@android:style/Animation.Activity">
        <!-- 打开新Activity：新Activity进入 -->
        <item name="android:activityOpenEnterAnimation">@null</item>
        <!-- 打开新Activity：当前Activity退出 -->
        <item name="android:activityOpenExitAnimation">@null</item>
        <!-- 关闭Activity：当关闭当前Activity后，下面的Activity进入 -->
        <item name="android:activityCloseEnterAnimation">@null</item>
        <!-- 关闭Activity：当前Activity关闭时退出 -->
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="ActivityJumpToAnimation" parent="@android:style/Animation.Activity">
        <!-- 打开新Activity：新Activity进入 -->
        <item name="android:activityOpenEnterAnimation">@anim/left_in</item>
        <!-- 打开新Activity：当前Activity退出 -->
        <item name="android:activityOpenExitAnimation">@anim/right_out</item>
        <!-- 关闭Activity：当关闭当前Activity后，下面的Activity进入 -->
        <item name="android:activityCloseEnterAnimation">@anim/right_in</item>
        <!-- 关闭Activity：当前Activity关闭时退出 -->
        <item name="android:activityCloseExitAnimation">@anim/left_out</item>
    </style>

