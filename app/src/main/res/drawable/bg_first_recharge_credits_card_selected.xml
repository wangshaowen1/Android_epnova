<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#A947FF"
                android:endColor="#F640C6"
                android:startColor="#3A44FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:inset="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape>
            <solid android:color="#FEFEFD" />
            <corners android:radius="10.5dp" />
        </shape>
    </item>
</layer-list>
