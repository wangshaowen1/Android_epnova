<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.login.unified.UnifiedLoginViewModel" />

        <import type="android.view.View" />

        <import type="android.text.method.LinkMovementMethod" />

        <import type="com.kuaigeglobal.epnova.common.utils.DebugUtils" />

        <import type="com.kuaigeglobal.epnova.common.Constant.SDKConfiguration" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kuaigeglobal.epnova.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/bt_settings"
            style="@style/Button.Menu"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_marginEnd="16dp"
            android:text="@string/title_settings"
            android:visibility="@{DebugUtils.INSTANCE.isDebug()?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnClose" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_logo_round"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.251" />

        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo" />

        <TextView
            style="@style/Text.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/login_ai_comic_journey"
            android:textColor="?attr/textColor3"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_title" />

        <LinearLayout
            android:id="@+id/btnFaceBook"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="@drawable/bg_3a74e7_r50"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnGoogle">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="53dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_facebook" />

            <TextView
                style="@style/Text.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:text="@string/login_facebook"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnGoogle"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:background="@drawable/bg_white_rectangle_corner_r50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7556">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="53dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_google" />

            <TextView
                style="@style/Text.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:text="@string/login_google"
                android:textColor="@color/color_0d0d0d"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            setVisible="@{layout.loginRewardsValid}"
            android:background="@drawable/bg_theme_color1_leaf_right"
            android:translationY="-20dp"
            app:layout_constraintEnd_toEndOf="@id/btnGoogle"
            app:layout_constraintTop_toTopOf="@id/btnGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_coins"
                android:layout_width="16dp"
                android:layout_height="16dp"/>

            <TextView
                android:layout_marginStart="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{@string/login_claim_coins(layout.loginRewards)}"
                android:textColor="?attr/textColor1"
                android:fontFamily="@font/outfit_medium"
                android:textSize="12sp"
                tools:text="@string/login_claim_coins" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_describe"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="55dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/btnGoogle">

            <TextView
                android:id="@+id/tv_agreement"
                style="@style/Text.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/lineSpacingExtra"
                android:textColor="?attr/textColor4"
                android:textColorHighlight="@android:color/transparent"
                android:textSize="12sp"
                tools:text="@string/agree_terms_privacy" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            singleClick="@{(v)->layout.back()}"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/spacing_s"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>