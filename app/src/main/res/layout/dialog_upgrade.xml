<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.base.viewmodel.EmptyViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        tools:layout_width="294dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Placeholder
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="294:58"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/upgradeBg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_white_r24"
            app:layout_constraintBottom_toBottomOf="@id/upgradeBottomLayout"
            app:layout_constraintTop_toBottomOf="@id/top" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/icon_upgrade_top_bg"
            app:layout_constraintDimensionRatio="294:225"
            app:layout_constraintTop_toBottomOf="@id/top"
            app:shapeAppearanceOverlay="@style/roundStyle_tr24" />

        <ImageView
            android:layout_width="147dp"
            android:layout_height="203dp"
            android:scaleType="fitXY"
            android:src="@drawable/icon_upgrade_rocket"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/upgradeTitleLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:textColor="@color/color_14141e"
                android:textSize="26sp"
                android:text="New Version" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:textColor="@color/color_ff2e55"
                android:textSize="26sp"
                android:text="Available" />

            <TextView
                android:id="@+id/version"
                style="@style/Text12.Outfit.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stroke_30_4d1515_r6"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/color_0d0d0d"
                tools:text="V1.2.0" />
        </LinearLayout>

        <com.kuaigeglobal.epnova.widget.AtMostScrollView
            android:id="@+id/llScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_white_r14"
            app:bottomFadingEdgeStrength="1"
            app:layout_constraintDimensionRatio="264:168"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/upgradeTitleLayout"
            app:topFadingEdgeStrength="0"
            app:verticalFadingEdgeEnabled="true">

            <TextView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textAppearance="@style/Text13.Outfit.Regular"
                android:textColor="@color/color_0d0d0d"
                tools:text="1. Refreshed home screen with abrand-new look.\n2. All-new interactions -Al-generated exclusive dramas, easierearnings. Everyone's a creator.\n3. Faster withdrawals, no daily limits.Cash out anytime - may the richesflow.\n4. Faster withdrawals, no daily limits.Cash out anytime - may the richesflow."/>
        </com.kuaigeglobal.epnova.widget.AtMostScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upgradeBottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llScrollView">

            <TextView
                android:id="@+id/upgrade"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/selector_upgrade_button"
                android:gravity="center"
                android:text="@string/update_now"
                android:textAppearance="@style/Text16.Outfit.Medium"
                android:textColor="@color/fixed_white_1"
                app:layout_constraintBottom_toTopOf="@id/cancel"
                app:layout_constraintDimensionRatio="254:44"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginBottom="24dp" />

            <TextView
                android:id="@+id/cancel"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/update_cancel"
                android:textAppearance="@style/Text13.Outfit.Regular"
                android:textColor="@color/text_color_dark_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/upgrade"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/close"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/icon_dialog_bottom_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/upgradeBg" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>