<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.base.viewmodel.EmptyViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_width="285dp">

        <androidx.constraintlayout.widget.Placeholder
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="285:18"
            app:layout_constraintTop_toTopOf="@+id/card" />

        <com.kuaigeglobal.epnova.widget.GradientBorderView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:backgroundStartColor="?attr/bgColor3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top"
            app:roundCornerRadius="24dp" />

        <View
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_upgrade"
            app:layout_constraintDimensionRatio="285:112"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="44dp"
            android:text="@string/new_version_found"
            android:textAppearance="@style/Text28"
            android:textColor="?attr/textColor1"
            app:layout_constraintStart_toStartOf="@id/card"
            app:layout_constraintTop_toTopOf="@id/card" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor3"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="V1.1.3" />

        <com.kuaigeglobal.epnova.widget.AtMostScrollView
            android:id="@+id/llScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:bottomFadingEdgeStrength="1"
            app:layout_constraintDimensionRatio="285:128"
            app:layout_constraintTop_toBottomOf="@+id/version"
            app:topFadingEdgeStrength="0"
            app:verticalFadingEdgeEnabled="true">

            <TextView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:textAppearance="@style/Text14"
                android:textColor="?attr/textColor1"
                tools:text="1.优化一键登录;\n2.优化完善资料;\n2.优化完善资料;\n2.优化完善资料;\n2.优化完善资料;\n2.优化完善资料;\n2.优化完善资料;\n2.优化完善资料;" />
        </com.kuaigeglobal.epnova.widget.AtMostScrollView>

        <TextView
            android:id="@+id/upgrade"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/selector_common_button"
            android:gravity="center"
            android:text="@string/update_now"
            android:textAppearance="@style/Text16"
            android:textColor="@color/fixed_white_1"
            app:layout_constraintDimensionRatio="237:44"
            app:layout_constraintTop_toBottomOf="@+id/llScrollView" />

        <androidx.constraintlayout.widget.Placeholder
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="285:24"
            app:layout_constraintTop_toBottomOf="@+id/upgrade" />

        <TextView
            android:id="@+id/cancel"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:text="@string/update_cancel"
            android:textAppearance="@style/Text13"
            android:textColor="?textColor3"
            app:layout_constraintDimensionRatio="237:44"
            app:layout_constraintTop_toBottomOf="@+id/upgrade" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>