<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.message.ItemNotificationVm" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_06_ffffff_r12"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            style="@style/Text16.Outfit.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.data.title}"
            android:textColor="?attr/textColor1"
            tools:text="&#x1F389; Your First Viewer!" />

        <TextView
            style="@style/Text14.Outfit.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@{item.data.content}"
            android:textColor="?attr/textColor4"
            tools:text="Your drama is live! EpNova is now finding your first viewers" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/border_color_2_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="@{item.isWorkTitle ? View.GONE : View.VISIBLE}">

                <TextView
                    android:id="@+id/tv_work_title_start"
                    style="@style/Text12.Outfit.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x300A;"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_work_title"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_work_title"
                    style="@style/Text12.Outfit.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@{item.data.workTitle}"
                    android:textColor="?attr/textColor3"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_work_title_end"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@id/tv_work_title_start"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="I Am Not a " />

                <TextView
                    android:id="@+id/tv_work_title_end"
                    style="@style/Text12.Outfit.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x300B;"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_work_title"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_marginLeft="2dp"
                style="@style/Text12.Outfit.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.timeText}"
                android:textColor="?attr/textColor4"
                tools:text="July 23, 2026" />
        </LinearLayout>
    </LinearLayout>
</layout>
