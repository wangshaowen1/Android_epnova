<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.settings.customerservice.CustomerServiceViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_2a2a2b_r24">

        <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
            android:id="@+id/bcl_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/selector_item_stroke"
            android:padding="16dp"
            app:borderEndColor="@color/gradient_btn_end_dark"
            app:borderStartColor="@color/gradient_btn_start_dark"
            app:borderWidth="1.5dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.62717"
            app:roundCornerRadius="@dimen/radius_xl"
            app:showBorder="@{true}">

            <com.kuaigeglobal.epnova.widget.AutoResizeImageView
                android:id="@+id/card"
                loadUri="@{layout.customerServiceUrl}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>


        <TextView
            android:id="@+id/custom_service_01"
            style="@style/Text16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/customer_service_long_press_to_save"
            android:textColor="?attr/textColor1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bcl_bg" />

        <TextView
            android:id="@+id/custom_service_02"
            style="@style/Text12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/customer_service_time"
            android:textColor="?attr/textColor3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/custom_service_01" />


        <Button
            android:id="@+id/btnClose"
            style="@style/Button.Bold"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:text="@string/my_understood"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/custom_service_02" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
