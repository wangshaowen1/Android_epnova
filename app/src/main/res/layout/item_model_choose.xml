<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.creator.set.ItemModelVm" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/fill_color1_r12"
        android:alpha="@{item.data.valid?1f:0.5f}"
        android:onClick="@{(v) -> item.onItemClick.invoke(v)}"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text14.Outfit.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="@{item.data.valid?1f:0.5f}"
            android:text="@{item.data.configName}"
            android:textColor="?attr/textColor1"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="解说漫模型" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Text12.Outfit.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_m"
            android:text="@{item.data.remark}"
            android:textColor="?attr/textColor3"
            app:layout_constraintEnd_toStartOf="@id/ivCheck"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            tools:text="AI漫画分镜 + 智能解说配音，适合快速出片、故事类解说。" />

        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_selected_white"
            android:visibility="@{item.checked ? View.VISIBLE : View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
