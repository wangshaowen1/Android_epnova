<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.creator.set.ItemModelVm" />

        <import type="com.kuaigeglobal.epnova.R" />
    </data>

    <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
        backgroundColorAttr="@{item.checked ? R.attr.modelCheckBg : R.attr.fillColor1}"
        showBorder="@{item.checked}"
        app:borderEndColor="@color/color_524dec"
        app:borderCenterColor="@color/color_7567f0"
        app:borderStartColor="@color/color_73b0f8"
        app:borderWidth="1.5dp"
        app:roundCornerRadius="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        tools:background="@drawable/fill_color1_r12"
        android:alpha="@{item.data.valid?1f:0.5f}"
        android:onClick="@{(v) -> item.onItemClick.invoke(v)}"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_l">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text14.Outfit.Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{item.data.configName}"
            android:textColor="?attr/textColor1"
            android:textStyle="normal"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvDesc"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0"
            tools:text="解说漫模型" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Text12.Outfit.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@{item.data.remark}"
            android:textColor="?attr/textColor3"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="AI漫画分镜 + 智能解说配音，适合快速出片、故事类解说。" />

<!--        <ImageView-->
<!--            android:id="@+id/ivCheck"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:src="@drawable/icon_selected_white"-->
<!--            android:visibility="@{item.checked ? View.VISIBLE : View.INVISIBLE}"-->
<!--            app:layout_constraintBottom_toBottomOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="parent"-->
<!--            tools:visibility="visible" />-->

    </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>
</layout>
