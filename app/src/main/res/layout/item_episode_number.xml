<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.play.more.ItemEpisodeNumberVm" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@{item.checked ? @drawable/fill_color1_r16 : @drawable/bg_ff2e55_r16}"
        android:onClick="@{(v) -> item.onItemClick.invoke(v)}"
        android:padding="0dp">

        <TextView
            android:id="@+id/tvEpisodeNumber"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@{String.valueOf(item.data.sortNo)}"
            android:textColor="@{item.checked ? @color/color_90_ffffff : @color/color_ff2e55}"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1" />

    </FrameLayout>
</layout>