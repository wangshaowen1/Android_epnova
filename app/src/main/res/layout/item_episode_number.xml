<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.play.more.ItemEpisodeNumberVm" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@{item.checked?@drawable/bg_10_ff2e55_r6:@drawable/fill_color1_r4 }"
        android:onClick="@{(v) -> item.onItemClick.invoke(v)}">

        <TextView
            android:id="@+id/tvEpisodeNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@{String.valueOf(item.data.sortNo)}"
            android:textColor="@{item.checked ?@color/color_ff2e55: @color/color_90_ffffff }"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1" />

        <ImageView
            setVisible="@{item.checked}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="4dp"
            android:src="@drawable/icon_episode_playing" />
    </FrameLayout>
</layout>