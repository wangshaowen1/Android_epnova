<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.create.child.ItemResourceCenterVm" />
    </data>

    <androidx.cardview.widget.CardView
        singleClick="@{(v)->item.onItemClick.invoke(v)}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        app:cardBackgroundColor="?attr/fillColor1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 资源中心封面大图 -->
            <ImageView
                android:id="@+id/ivNewsCover"
                loadThumbnailUri="@{item.data.coverImageUrl}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="345:126"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 标题 -->
            <TextView
                android:id="@+id/tvNewsName"
                style="@style/Text14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="17dp"
                android:paddingVertical="12dp"
                android:text="@{item.data.consultTitle}"
                android:textColor="?attr/textColor1"
                app:layout_constraintTop_toBottomOf="@id/ivNewsCover"
                tools:text="Short-Form AI Dramas Are Reshaping How Gen Z Consumes Stories" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>
