<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/black">

    <View
        android:id="@+id/progressBg"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_10_ffffff_r6"
        app:layout_constraintBottom_toBottomOf="@+id/thumb"
        app:layout_constraintTop_toTopOf="@+id/thumb" />

    <View
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.66"
        android:background="@drawable/bg_ffffff_r4"
        app:layout_constraintBottom_toBottomOf="@+id/progressBg"
        app:layout_constraintEnd_toStartOf="@+id/progress"
        app:layout_constraintStart_toStartOf="@+id/progressBg"
        app:layout_constraintTop_toTopOf="@+id/progressBg" />

    <View
        android:id="@+id/progress"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="@+id/progressBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBg"
        app:layout_constraintStart_toStartOf="@+id/progressBg" />

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="12dp"
        android:src="@drawable/oval_ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/progress"
        app:layout_constraintStart_toStartOf="@+id/progress" />

    <ImageView
        android:id="@+id/dragLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_back"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/times"
        app:layout_constraintEnd_toStartOf="@id/times"
        app:layout_constraintTop_toTopOf="@id/times"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/dragRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_advance"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/times"
        app:layout_constraintStart_toEndOf="@id/times"
        app:layout_constraintTop_toTopOf="@id/times"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/times"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/progressBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBg"
        app:layout_constraintStart_toStartOf="@+id/progressBg"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="00:21" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="/"
            android:textColor="@color/color_70_ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/color_70_ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="02:42" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>