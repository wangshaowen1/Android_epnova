<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.home.search.ItemSearchResultVm" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        singleClick="@{(v)->item.onItemClick.invoke(v)}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_l"
        android:paddingHorizontal="@dimen/spacing_l">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCover"
            loadUri="@{item.data.workCoverUrl}"
            placeHolder="@{@drawable/img_default_cover_3_4}"
            android:layout_width="82dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundStyle_r8"
            tools:src="@drawable/img_default_cover_3_4" />

        <TextView
            style="@style/Text.Regular"
            android:id="@+id/tvTitle"
            titleText="@{item.data.workTitle}"
            highlightKeyword="@{item.keyWord}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/textColor1"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCover"
            app:layout_constraintTop_toTopOf="@id/ivCover"
            tools:text="Master of All Arts, Conqueror of Love (DUBBED)" />

        <!-- authorName 字段需在 WorkVOInfo 中补充 -->
        <TextView
            style="@style/Text.Regular"
            android:id="@+id/tvAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.data.nickName}"
            android:textColor="?attr/textColor4"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCover"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Sarah" />

        <TextView
            style="@style/Text.Regular"
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@{item.data.workDesc}"
            android:textColor="?attr/textColor4"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCover"
            app:layout_constraintTop_toBottomOf="@id/tvAuthor"
            tools:text="Disciple of Berge Sanctum, FrankCole, descends the mountain and goes to Toans. He asks for Linda T..." />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
