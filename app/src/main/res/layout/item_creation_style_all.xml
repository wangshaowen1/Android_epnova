<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.creator.set.allstyle.ItemCreationStyleVm" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{(v)->item.onItemClick.invoke(v)}"
            app:borderEndColor="@color/gradient_btn_end_dark"
            app:borderStartColor="@color/gradient_btn_start_dark"
            app:borderWidth="1.5dp"
            app:roundCornerRadius="@dimen/radius_m"
            app:showBorder="@{item.checked}">

            <com.kuaigeglobal.epnova.widget.CropShapeImageView
                android:id="@+id/ivCover"
                loadThumbnailUri="@{item.data.styleCoverUrl}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundStyle_r8" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_vip54"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/Text12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_top_00_000000_bottom_60_000000_br8"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingVertical="@dimen/spacing_s"
                android:singleLine="true"
                android:text="@{item.data.styleName}"
                android:textColor="?attr/textColor1"
                app:layout_constraintBottom_toBottomOf="@id/ivCover"
                tools:text="日式动漫" />
        </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>
    </FrameLayout>
</layout>