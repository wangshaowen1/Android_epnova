<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text16"
            setTextBold="@{true}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/edit_story_summary"
            android:textColor="?attr/textColor1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.kuaigeglobal.epnova.widget.CounterInputLayout
            android:id="@+id/inputView"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_fill_color_1_r8"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="top|start"
            app:inputHint="@string/input_original_story_content"
            app:inputCounterGravity="right"
            app:inputCounterRightMargin="0dp"
            app:inputCounterTextColor="?attr/textColor4"
            app:inputCounterTextSize="12sp"
            app:inputCounterVisible="true"
            app:inputHorizontalPadding="@dimen/spacing_m"
            app:inputTextColor="?attr/textColor2"
            app:inputTextColorHint="?attr/textColor4"
            app:inputTextSize="14sp"
            app:inputVerticalPadding="@dimen/spacing_m"
            app:layout_constraintTop_toTopOf="parent"
            app:inputMaxLength="500" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginStart="@dimen/spacing_l"
            android:padding="3dp"
            android:src="@drawable/icon_close"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <Button
            android:id="@+id/btnOk"
            style="@style/Text14"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="@dimen/spacing_l"
            android:background="@drawable/bg_theme_color1_r50"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/confirm_ok"
            android:textColor="?attr/textColor1"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>