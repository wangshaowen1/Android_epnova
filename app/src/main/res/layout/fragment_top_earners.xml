<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.kuaigeglobal.epnova.feature.create.child.TopEarnersViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
            android:id="@+id/lsv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:stateViewTopPadding="60dp"
            app:noData="@string/no_data"
            app:noDataSrc="@drawable/icon_state_no_data">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                setLinearLayoutManager="@{true}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp"
                android:overScrollMode="never"
                tools:listitem="@layout/item_top_earners" />
        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
    </FrameLayout>
</layout>
