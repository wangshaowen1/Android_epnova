<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.create.child.TopEarnersViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/srl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:overScrollMode="never"
            app:srlAccentColor="@color/white"
            app:srlEnablePreviewInEditMode="true"
            app:srlPrimaryColor="@color/transparent">

            <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
                android:id="@+id/lsv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:noData="@string/empty_creation_history">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    setLinearLayoutManager="@{true}"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                    tools:listitem="@layout/item_top_earners" />
            </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </FrameLayout>
</layout>



