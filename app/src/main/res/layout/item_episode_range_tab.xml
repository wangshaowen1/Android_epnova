<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.play.more.ItemEpisodeRangeVm" />

        <import type="android.view.View" />
    </data>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="@{(v) -> item.onItemClick.invoke(v)}"
        android:paddingEnd="30dp"
        android:paddingVertical="@dimen/spacing_s"
        android:text="@{item.data.segmentLabel}"
        android:textColor="@{item.selected ? @color/color_90_ffffff :  @color/color_50_ffffff}"
        tools:text="1 - 30" />

</layout>