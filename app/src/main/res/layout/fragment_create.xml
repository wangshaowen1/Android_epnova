<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.create.CreateViewModel" />
    </data>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        app:srlPrimaryColor="@color/transparent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@drawable/appbar_elevation">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/llTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.zhpan.bannerview.BannerViewPager
                            android:id="@+id/banner"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:bvp_can_loop="true"
                            app:bvp_indicator_visibility="gone"
                            app:bvp_interval="4000"
                            app:bvp_scroll_duration="600"
                            android:layout_marginBottom="35dp"
                            app:layout_constraintVertical_bias="0"
                            app:layout_constraintDimensionRatio="375:246"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.zhpan.indicator.IndicatorView
                            android:id="@+id/iv_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="4dp"
                            android:layout_marginEnd="@dimen/spacing_l"
                            android:layout_marginBottom="18dp"
                            app:layout_constraintBottom_toTopOf="@id/btnCreation"
                            app:layout_constraintEnd_toEndOf="@id/banner" />

                        <Button
                            android:id="@+id/btnCreation"
                            style="@style/Button.Medium.Gradient"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginBottom="24dp"
                            app:layout_constraintDimensionRatio="335:48"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <com.kuaigeglobal.epnova.widget.ShimmerView
                            app:layout_constraintBottom_toBottomOf="@id/btnCreation"
                            app:layout_constraintEnd_toEndOf="@id/btnCreation"
                            app:layout_constraintStart_toStartOf="@id/btnCreation"
                            app:layout_constraintTop_toTopOf="@id/btnCreation"
                            app:svAnimMode="auto"
                            app:svRadius="90dp"
                            app:svRepeat="-1"
                            app:svSlope="-1"
                            app:svPositions="0,0.5,1"
                            app:svColors="#00FFFFFF,#5AFFFFFF,#00FFFFFF"
                            app:svDuration="2000"
                            android:layout_width="0dp"
                            android:layout_height="0dp"/>

                        <TextView
                            android:textSize="16sp"
                            style="@style/Text.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/icon_ai"
                            android:drawablePadding="10dp"
                            android:gravity="center"
                            android:text="@string/create_page_short_dramas"
                            android:textColor="@color/sel_common_button_txt"
                            app:layout_constraintBottom_toBottomOf="@id/btnCreation"
                            app:layout_constraintEnd_toEndOf="@id/btnCreation"
                            app:layout_constraintStart_toStartOf="@id/btnCreation"
                            app:layout_constraintTop_toTopOf="@id/btnCreation" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>

                <com.nhsd.magicindicator.MagicIndicator
                    android:id="@+id/magic_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    app:layout_scrollFlags="enterAlways"
                    android:layout_marginBottom="@dimen/spacing_l" />
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</layout>
