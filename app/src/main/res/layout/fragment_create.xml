<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.create.CreateViewModel" />
    </data>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:overScrollMode="never"
        app:srlAccentColor="@color/color_121212"
        app:srlEnableLoadMore="false"
        app:srlEnableNestedScrolling="true"
        app:srlEnableOverScrollBounce="false"
        app:srlEnableOverScrollDrag="false"
        app:srlEnablePreviewInEditMode="true"
        app:srlEnableRefresh="true"
        app:srlPrimaryColor="@color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.zhpan.bannerview.BannerViewPager
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:bvp_can_loop="true"
                    app:bvp_indicator_visibility="gone"
                    app:bvp_interval="4000"
                    app:bvp_scroll_duration="600"
                    app:layout_constraintDimensionRatio="375:246"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.zhpan.indicator.IndicatorView
                    android:id="@+id/iv_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="4dp"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:layout_marginBottom="30dp"
                    app:layout_constraintBottom_toBottomOf="@id/banner"
                    app:layout_constraintEnd_toEndOf="@id/banner" />

                <Button
                    android:id="@+id/btnCreation"
                    style="@style/Button.Bold.Gradient"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="-12dp"
                    app:layout_constraintDimensionRatio="325:48"
                    app:layout_constraintTop_toBottomOf="@id/banner" />

                <TextView
                    style="@style/Text16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_ai"
                    android:drawablePadding="10dp"
                    android:text="@string/create_page_short_dramas"
                    android:textColor="@color/sel_common_button_txt"
                    app:layout_constraintBottom_toBottomOf="@id/btnCreation"
                    app:layout_constraintEnd_toEndOf="@id/btnCreation"
                    app:layout_constraintStart_toStartOf="@id/btnCreation"
                    app:layout_constraintTop_toTopOf="@id/btnCreation" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.nhsd.magicindicator.MagicIndicator
                android:id="@+id/magic_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="@dimen/spacing_l" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</layout>