<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:id="@+id/load_more_loading_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="15dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/load_more_loading_view_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:indeterminateTint="@color/color_6a6a6a" />

        <TextView
            android:id="@+id/load_more_loading_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/brvah_loading"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/load_more_load_fail_small_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="15dp"
        >

        <TextView
            android:id="@+id/load_more_load_fail_small_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brvah_load_failed"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/load_more_load_fail_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/load_more_load_fail_view_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="128dp"
            android:src="@drawable/empty_network" />

        <TextView
            android:id="@+id/load_more_load_fail_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@string/page_network_error"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/load_more_load_fail_view_retry"
            style="@style/Button.Bold"
            android:layout_width="122dp"
            android:layout_height="41dp"
            android:layout_marginVertical="20dp"
            android:gravity="center"
            android:text="@string/refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/load_more_load_empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/load_more_load_empty_view_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="128dp"
            android:src="@drawable/ic_not_song" />

        <TextView
            android:id="@+id/load_more_load_empty_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@string/page_empty"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/load_more_load_empty_view_retry"
            android:layout_width="122dp"
            android:layout_height="41dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/bg_empty_button"
            android:gravity="center"
            android:text="@string/refresh"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/load_more_load_complete_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/load_more_load_complete_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/brvah_load_complete"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/load_more_load_end_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="15dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/load_more_load_end_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_more_data"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>