<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.settings.about.AboutUsViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/bg_guang" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/action_bar_size"
                android:orientation="vertical">

                <com.kuaigeglobal.epnova.widget.StatusBarView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="30dp"
                    android:src="@mipmap/ic_launcher"
                    app:shapeAppearance="@style/roundStyle_r16" />

                <TextView
                    style="@style/Text.Common"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:text="@string/app_name"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_version_number"
                        android:textColor="@color/color_50_121212"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.appVersion}"
                        android:textColor="@color/color_50_121212"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_white_rectangle_corner_r16"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sll_user_agreement"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background_top_r16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_user_agreement"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_privacy_policy"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_privacy_policy"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/sll_information_collection"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_information_collection"
                            android:textColor="@color/color_21213b"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_shared_list"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_shared_list"
                            android:textColor="@color/color_21213b"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_algorithm_formula"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_algorithm_formula"
                            android:textColor="@color/color_21213b"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_filing_number"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background_bottom_r16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_filing_number"
                            android:textColor="@color/color_21213b"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{layout.beiAn}"
                            android:textColor="@color/color_40_121212"
                            android:textSize="12sp"
                            tools:text="粤ICP备2020100243号-19A" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />
    </FrameLayout>

</layout>