<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.play.more.EpisodeChooseViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20">

        <!-- 视频信息区域 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/videoInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 视频封面 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivCover"
                loadHQThumbnailUri="@layout.headerInfo.workCoverUrl}"
                android:layout_width="64dp"
                android:layout_height="85dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/roundStyle_r8"
                tools:background="@drawable/img_default_cover_3_4" />

            <!-- 视频标题 -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/Text16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{layout.episodeInfo.workTitle}"
                android:textColor="?attr/textColor1"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvViews"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivCover"
                app:layout_constraintTop_toTopOf="@id/ivCover"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="My wife doesn't love my anymore" />

            <!-- 播放量 -->
            <TextView
                android:id="@+id/tvViews"
                style="@style/Text12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.episodeInfo.formattedPlayCount + ` views`}"
                android:textColor="?attr/textColor3"
                app:layout_constraintBottom_toBottomOf="@id/ivCover"
                app:layout_constraintStart_toEndOf="@id/ivCover"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                tools:text="604k views" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 关闭按钮 -->
        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:onClick="@{()->layout.dismiss()}"
            android:padding="3dp"
            android:src="@drawable/icon_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 标签栏 RecyclerView (横向滚动) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRangeTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="16dp"
            android:adapter="@{layout.MRangeAdapterVm.MAdapter}"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/videoInfoLayout"
            tools:listitem="@layout/item_episode_range_tab" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:adapter="@{layout.MEpisodeAdapterVm.MAdapter}"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvRangeTabs"
            tools:listitem="@layout/item_episode_number" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>