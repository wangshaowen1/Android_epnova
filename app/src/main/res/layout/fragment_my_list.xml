<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.works.MyListModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <com.kuaigeglobal.epnova.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <com.nhsd.magicindicator.MagicIndicator
            android:id="@+id/magic_indicator"
            setVisible="@{!layout.editModel}"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_size"
            android:layout_marginStart="@dimen/spacing_l"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/statusBar"
            tools:layout_editor_absoluteX="0dp" />

        <ImageView
            android:id="@+id/btnEdit"
            android:visibility="gone"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="54dp"
            android:layout_height="@dimen/action_bar_size"
            android:importantForAccessibility="no"
            android:paddingHorizontal="15dp"
            android:src="@drawable/icon_edit"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@id/magic_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/magic_indicator" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/magic_indicator" />

        <com.kuaigeglobal.epnova.widget.MoveFrameLayout
            android:id="@+id/floating_ball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginBottom="14dp"
            android:padding="@dimen/spacing_m"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivFloating"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/img_floating" />
        </com.kuaigeglobal.epnova.widget.MoveFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>