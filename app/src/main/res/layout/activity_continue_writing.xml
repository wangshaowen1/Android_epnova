<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.continuewriting.ContinueWritingViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:keepScreenOn="true"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <TextView
            style="@style/Text14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/ep_summary"
            android:textColor="?attr/textColor1"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_l">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                loadHQThumbnailUri="@{layout.episodeInfo.workCoverUrl}"
                placeHolder="@{@drawable/img_default_cover_4_3}"
                android:layout_width="78dp"
                android:layout_height="104dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/roundStyle_r8"
                tools:src="@drawable/img_default_cover_4_3" />

            <TextView
                android:id="@+id/tv_name"
                style="@style/Text16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{layout.combinationTitle}"
                android:textColor="?attr/textColor1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toTopOf="@id/iv_avatar"
                tools:text="第1章" />

            <TextView
                android:id="@+id/tv_desc"
                style="@style/Text12"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_s"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@{layout.episodeInfo.storyContent}"
                android:textColor="?attr/textColor4"
                app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintTop_toBottomOf="@id/tv_name"
                tools:text="上学的时候黄元元是那种特别讨厌的同学，" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            style="@style/Text14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/continue_series"
            android:textColor="?attr/textColor1"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_weight="1"
            android:background="@drawable/bg_fill_color_1_r8">

            <com.kuaigeglobal.epnova.widget.CounterInputLayout
                android:id="@+id/inputView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/spacing_m"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="top|start"
                android:maxLength="@{layout.maxInputLength}"
                app:inputCounterGravity="right"
                app:inputCounterRightMargin="0dp"
                app:inputCounterTextColor="?attr/textColor4"
                app:inputCounterTextSize="12sp"
                app:inputCounterVisible="false"
                app:inputHint="@string/input_original_story_content"
                app:inputHorizontalPadding="@dimen/spacing_m"
                app:inputTextColor="?attr/textColor2"
                app:inputTextColorHint="?attr/textColor4"
                app:inputTextSize="14sp"
                app:inputVerticalPadding="@dimen/spacing_m"
                app:layout_constraintBottom_toTopOf="@id/llBottom"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/inputView"
                app:layout_constraintEnd_toEndOf="@id/inputView"
                app:layout_constraintStart_toStartOf="@id/inputView"
                app:layout_constraintTop_toTopOf="@id/inputView">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_loading_fail"
                    android:drawablePadding="@dimen/spacing_l"
                    android:gravity="center"
                    android:text="@string/error_gen"
                    android:textColor="?attr/textColor4"
                    android:textSize="14sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/llBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/tvContentLength"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvContentLength">

                <TextView
                    android:id="@+id/btnRegenerate"
                    style="@style/Text12"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:background="@drawable/bg_fill_color_3_r50"
                    android:drawablePadding="@dimen/spacing_xs"
                    setVisible="@{layout.input.length()>0}"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="@string/regenerate"
                    android:textColor="?attr/textColor2"
                    app:drawableStartCompat="@drawable/icon_refresh_1_12" />

                <TextView
                    android:id="@+id/btnAIExpand"
                    style="@style/Text12"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:background="@drawable/bg_fill_color_3_r50"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    setVisible="@{layout.input.length()==0}"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="@string/extend_text"
                    android:textColor="?attr/textColor2"
                    app:drawableStartCompat="@drawable/icon_optimize12" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="@dimen/spacing_s"
                    android:background="?attr/borderColor2"
                    android:visibility="@{layout.input.length()>0?View.VISIBLE:View.GONE}" />

                <ImageView
                    android:id="@+id/btnDelete"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:src="@drawable/icon_delete"
                    android:visibility="@{layout.input.length()>0?View.VISIBLE:View.GONE}" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvContentLength"
                style="@style/Text12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_l"
                android:text="@{layout.input.length()+`/`+layout.maxInputLength}"
                android:textColor="?attr/textColor4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="0/5000" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btnNext"
            style="@style/Button.Bold"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="30dp"
            android:text="@string/next_step" />
    </LinearLayout>
</layout>