<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l"
    android:paddingTop="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/ic_prompt"
            android:gravity="center"
            android:layout_marginEnd="@dimen/spacing_s"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mybalace_compute_evaluate"
            android:textColor="@color/text_color_3_dark"
            android:textSize="12sp"
            android:lineHeight="@dimen/sp_16"/>
    </LinearLayout>

    <!-- Tips 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mybalace_rules_tips"
        android:textColor="@color/text_color_3_dark"
        android:textSize="12sp"
        android:lineHeight="@dimen/sp_16"
        android:layout_marginTop="@dimen/spacing_xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mybalace_tips_rules"
        android:textColor="@color/text_color_4_dark"
        android:textSize="12sp"
        android:lineHeight="21sp"
        android:layout_marginTop="@dimen/spacing_l"/>




</LinearLayout>
