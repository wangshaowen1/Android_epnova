<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.ShortDramaCreationPackageViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fill_color1_r12"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Text18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/creation_package_unused_title"
            android:textColor="?attr/textColor1"
            android:textStyle="bold" />

        <TextView
            style="@style/Text13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@{layout.subtitleText(layout.selectedPackage)}"
            android:textColor="?attr/textColor3"
            tools:text="Choose a package to use" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/basicPackageCard"
                style="@style/Text14"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:alpha="@{layout.firstPackageSelected ? 1f : 0.65f}"
                android:background="@drawable/bg_08_ffffff_r20"
                android:gravity="center"
                android:padding="8dp"
                android:text="@{layout.titleText(layout.firstPackage) + `\n` + layout.firstPackage.displayDesc}"
                android:textColor="?attr/textColor1" />

            <TextView
                android:id="@+id/boutiquePackageCard"
                style="@style/Text14"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:alpha="@{layout.secondPackageSelected ? 1f : 0.65f}"
                android:background="@drawable/bg_08_ffffff_r20"
                android:gravity="center"
                android:padding="8dp"
                android:text="@{layout.titleText(layout.secondPackage) + `\n` + layout.secondPackage.displayDesc}"
                android:textColor="?attr/textColor1"
                android:visibility="@{layout.secondPackage == null ? View.GONE : View.VISIBLE}" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Text14"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/creation_package_not_use"
                android:textColor="?attr/textColor2" />

            <TextView
                android:id="@+id/btnUse"
                style="@style/Button.Bold"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_theme_color1_r50"
                android:gravity="center"
                android:text="@string/creation_package_use_now" />
        </LinearLayout>
    </LinearLayout>
</layout>
