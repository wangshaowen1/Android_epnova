<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.creator.generate.ItemStorySummaryGenerateVm" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:background="@drawable/fill_color1_r8"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            style="@style/Text14.Outfit.Medium"
            android:layout_width="match_parent"
            android:text="@{item.data.storyTitle}"
            android:layout_height="wrap_content"
            android:textColor="?attr/textColor1"
            tools:text="第 1 集 | 武魂觉醒" />

        <TextView
            style="@style/Text14.Outfit.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@{item.data.storySummary}"
            android:textColor="?attr/textColor3"
            tools:text="唐三在武魂觉醒仪式上，意外觉醒出被视为“废武魂”的蓝银草，却暗中展现出不寻常的天赋。" />
    </LinearLayout>
</layout>