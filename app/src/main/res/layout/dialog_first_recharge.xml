<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.splash.newer.FirstRechargeViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/bg"
            loadUri="@{layout.data.imageUrl}"
            placeHolder="@{@drawable/img_default_cover_3_4}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/first_recharge_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/bg"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg"
            app:layout_constraintTop_toTopOf="@id/bg"
            app:layout_constraintVertical_bias="0.358">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/limited_time_discount"
                android:textColor="#420A11"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hour"
                style="@style/CountDownTextStyle"
                android:text="@{layout.hourStr}"
                tools:text="23" />

            <TextView
                style="@style/CountDownColonStyle"
                android:text=":" />

            <TextView
                android:id="@+id/tv_minute"
                style="@style/CountDownTextStyle"
                android:text="@{layout.minuteStr}"
                tools:text="59" />

            <TextView
                style="@style/CountDownColonStyle"
                android:text=":" />

            <TextView
                android:id="@+id/tv_second"
                style="@style/CountDownTextStyle"
                android:text="@{layout.secondStr}"
                tools:text="00" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPay"
            singleClick="@{()->layout.wxPay()}"
            android:layout_width="300dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="@id/bg"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg"
            app:layout_constraintTop_toTopOf="@id/bg"
            app:layout_constraintVertical_bias="0.945" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:src="@drawable/icon_dialog_bottom_close"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg"
            app:layout_constraintTop_toBottomOf="@id/bg" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
