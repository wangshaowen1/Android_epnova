<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.recharge.MyBalanceViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            toolbar="@{layout.toolbar}" />

        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::loadConfig}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="100dp">

                        <TextView
                            android:id="@+id/tvBalance"
                            android:layout_width="69dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:fontFamily="@font/outfit_regular"
                            android:gravity="center"
                            android:text="@string/store_coins"
                            android:textAppearance="@style/Text12"
                            android:textColor="?attr/textColor3"
                            app:layout_constraintEnd_toStartOf="@id/tvRewardsCoins"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivPower"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_coins"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPower"
                            app:layout_constraintEnd_toStartOf="@+id/tvPower"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="@id/tvBalance"
                            app:layout_constraintTop_toTopOf="@+id/tvPower" />

                        <TextView
                            android:id="@+id/tvPower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/outfit_medium"
                            android:text="@{layout.balance}"
                            android:textColor="?attr/textColor1"
                            android:textSize="20sp"
                            app:layout_constraintEnd_toEndOf="@id/tvBalance"
                            app:layout_constraintStart_toEndOf="@+id/ivPower"
                            app:layout_constraintTop_toBottomOf="@+id/tvBalance"
                            tools:text="1000" />

                        <TextView
                            android:id="@+id/tvRewardsCoins"
                            android:layout_width="98dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:fontFamily="@font/outfit_regular"
                            android:gravity="center"
                            android:text="@string/store_reward_coins"
                            android:textAppearance="@style/Text12"
                            android:textColor="?attr/textColor3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvBalance"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivRewardsCoins"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_coins"
                            app:layout_constraintBottom_toBottomOf="@+id/tvRewardsCoinsBalance"
                            app:layout_constraintEnd_toStartOf="@+id/tvRewardsCoinsBalance"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="@id/tvRewardsCoins"
                            app:layout_constraintTop_toTopOf="@+id/tvRewardsCoinsBalance" />

                        <TextView
                            android:id="@+id/tvRewardsCoinsBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/outfit_medium"
                            android:text="@{layout.balance}"
                            android:textColor="?attr/textColor1"
                            android:textSize="20sp"
                            app:layout_constraintEnd_toEndOf="@id/tvRewardsCoins"
                            app:layout_constraintStart_toEndOf="@+id/ivRewardsCoins"
                            app:layout_constraintTop_toBottomOf="@+id/tvRewardsCoins"
                            tools:text="1000" />

                        <include
                            android:id="@+id/banner"
                            banner="@{layout.workCourseBanner}"
                            layout="@layout/layout_common_banner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="15dp"
                            android:layout_marginTop="24dp"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@+id/tvPower" />

                        <TextView
                            android:id="@+id/tvRechargeAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_l"
                            android:layout_marginTop="20dp"
                            android:text="@string/select_recharge_amount"
                            android:textAppearance="@style/Text16"
                            android:textColor="?attr/textColor2"
                            android:textStyle="normal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/banner" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRechargeAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:adapter="@{layout.powerAdapter}"
                            android:overScrollMode="never"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp"
                            android:scrollbars="none"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:layout_constraintTop_toBottomOf="@+id/tvRechargeAmount"
                            app:spanCount="2"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_recharge_power" />

                        <include
                            android:id="@+id/my_balance_bottom_view"
                            layout="@layout/my_balance_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/rvRechargeAmount" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

                <TextView
                    singleClick="@{(v)->layout.recharge()}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="@string/top_up_now"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/llPolicy"
                    app:layout_constraintDimensionRatio="345:44"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.92" />

                <LinearLayout
                    android:id="@+id/llPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agree_to_purchase"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor3" />

                    <TextView
                        singleClick="@{(v)->layout.viewPaymentAgreement()}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="@string/payment_agreement_show"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor1" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
    </LinearLayout>

</layout>