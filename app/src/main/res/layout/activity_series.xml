<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.series.SeriesViewModel" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::getWorkDtl}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kuaigeglobal.epnova.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnSelfPublish"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_bar_size"
                    android:drawableStart="@drawable/icon_self_publish"
                    android:gravity="center_vertical"
                    android:text="@string/self_publishing"
                    android:visibility="gone"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor2"
                    app:layout_constraintEnd_toStartOf="@+id/btnMore"
                    app:layout_constraintTop_toTopOf="@+id/btnMore"
                    app:layout_goneMarginEnd="16dp" />

                <ImageView
                    android:id="@+id/btnMore"
                    setVisible="@{layout.workInfo.isMine()}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="48dp"
                    android:layout_height="@dimen/action_bar_size"
                    android:layout_marginEnd="8dp"
                    android:paddingVertical="10dp"
                    android:src="@drawable/icon_more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/action_bar_size"
                    app:layout_constraintBottom_toTopOf="@+id/btnContainer"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar">

                    <com.google.android.material.appbar.AppBarLayout
                        android:id="@+id/appBarLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:elevation="0dp"
                        android:stateListAnimator="@drawable/appbar_elevation">

                        <com.google.android.material.appbar.CollapsingToolbarLayout
                            android:id="@+id/toolbarLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="scroll|exitUntilCollapsed">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingBottom="12dp">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivCover"
                                    loadThumbnailUri="@{layout.workInfo.workCoverUrl}"
                                    placeHolder="@{@drawable/img_default_cover_3_4}"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="12dp"
                                    android:scaleType="centerCrop"
                                    app:layout_constraintDimensionRatio="78:104"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="0.208"
                                    app:shapeAppearanceOverlay="@style/roundStyle_r8"
                                    tools:src="@drawable/img_default_cover_3_4" />

                                <ImageView
                                    imageResource="@{layout.workLevelIcon(layout.workInfo.contractLevel)}"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintDimensionRatio="34:16"
                                    app:layout_constraintStart_toStartOf="@+id/ivCover"
                                    app:layout_constraintTop_toTopOf="@+id/ivCover"
                                    app:layout_constraintWidth_percent="0.0907"
                                    tools:src="@drawable/icon_work_level_s" />

                                <TextView
                                    android:id="@+id/tvTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="15dp"
                                    android:ellipsize="end"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                                    android:maxLines="2"
                                    android:text="@{layout.workInfo.workTitle}"
                                    android:textAppearance="@style/Text18"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/ivCover"
                                    app:layout_constraintTop_toTopOf="@+id/ivCover"
                                    tools:text="代码纪元：觉醒指令" />

                                <TextView
                                    android:id="@+id/tvEpisodeCnt"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@{@string/creation_progress_format(layout.workInfo.finishedEpisodeCnt, layout.workInfo.totalEpisodeCnt)}"
                                    android:textAppearance="@style/Text12"
                                    android:textColor="?attr/textColor3"
                                    app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                                    app:layout_constraintStart_toStartOf="@+id/tvTitle"
                                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                                    tools:text="已创作 N 集 / 共M集" />

                                <LinearLayout
                                    android:id="@+id/llPublishStatus"
                                    singleClick="@{layout.clickHandler::onClick}"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="@+id/tvEpisodeCnt"
                                    app:layout_constraintTop_toBottomOf="@+id/tvEpisodeCnt">

                                    <ImageView
                                        setVisible="@{layout.publishFailed(layout.workInfo)}"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:src="@drawable/icon_attention_fail" />

                                    <TextView
                                        android:id="@+id/tvPublishStatus"
                                        textColorRes="@{layout.publishStatusColor(layout.workInfo)}"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone"
                                        android:text="@{layout.publishStatusText(layout.workInfo)}"
                                        android:textAppearance="@style/Text13"
                                        tools:text="已发行"
                                        tools:textColor="@color/func_success_dark" />

                                    <androidx.recyclerview.widget.RecyclerView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:layout_weight="1"
                                        android:adapter="@{layout.publishedPlatformAdapter}"
                                        android:orientation="horizontal"
                                        android:overScrollMode="never"
                                        android:scrollbars="none"
                                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                        tools:listitem="@layout/item_publish_platform" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvSeriesIntro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:text="@string/work_description"
                                    android:textAppearance="@style/Text14"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintStart_toStartOf="@+id/ivCover"
                                    app:layout_constraintTop_toBottomOf="@+id/ivCover" />

                                <com.kuaigeglobal.epnova.widget.expandtextview.ExpandableTextView
                                    android:id="@+id/tvSeriesIntroDesc"
                                    text="@{layout.workInfo.workDesc}"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="15dp"
                                    android:layout_marginTop="12dp"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                                    android:textColor="?textColor3"
                                    android:textSize="13sp"
                                    app:collapseLines="3"
                                    app:collapseTipLabel="@string/collapse"
                                    app:expandTipLabel="@string/expand"
                                    app:expandable="true"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntro"
                                    app:tipPosition="align_right"
                                    app:tipsColor="?attr/textColor1"
                                    app:tipsSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:text="@string/series_directory"
                                    android:textAppearance="@style/Text14"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintStart_toStartOf="@+id/tvSeriesIntro"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntroDesc" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.appbar.CollapsingToolbarLayout>

                    </com.google.android.material.appbar.AppBarLayout>

                    <com.scwang.smart.refresh.layout.SmartRefreshLayout
                        android:id="@+id/swipeRefreshLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:overScrollMode="never"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                        app:srlAccentColor="@color/color_121212"
                        app:srlEnablePreviewInEditMode="true"
                        app:srlPrimaryColor="@color/transparent">

                        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
                            android:id="@+id/loadStateViewHolder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:scrollable="true">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:overScrollMode="never"
                                android:paddingHorizontal="9dp"
                                android:scrollbars="none"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:spanCount="3"
                                tools:listitem="@layout/item_my_episode_info" />

                        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>

                    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnContainer"
                    setVisible="@{layout.workInfo.showPublishButton == 1 &amp;&amp; layout.workInfo.contractStatus != 2}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:id="@+id/btnPublish"
                        setEnabled="@{layout.workInfo.contractStatus != 1}"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@drawable/selector_common_button"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintDimensionRatio="345:44"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            setVisible="@{layout.workInfo.contractStatus == 0}"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/icon_add" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{layout.publishButtonText(layout.workInfo)}"
                            android:textAppearance="@style/Text16"
                            android:textColor="@color/fixed_white_1"
                            tools:text="去发行" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kuaigeglobal.epnova.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="48dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>
    </FrameLayout>
</layout>