<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.StoryUploadViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_2a2a2b_r24"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_sensitive_word" />

        <TextView
            style="@style/Text16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/sensitive_word_detected"
            android:textColor="?attr/textColor1" />

        <TextView
            style="@style/Text14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            android:text="@string/sensitive_content_refunded"
            android:textColor="?attr/textColor3" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:background="@drawable/fill_color1_r12"
            android:padding="@dimen/spacing_m">

            <ImageView
                android:id="@+id/bg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/fill_color3_r8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/img_text"
                app:layout_constraintBottom_toBottomOf="@id/bg"
                app:layout_constraintEnd_toEndOf="@id/bg"
                app:layout_constraintStart_toStartOf="@id/bg"
                app:layout_constraintTop_toTopOf="@id/bg" />

            <TextView
                android:id="@+id/fileName"
                style="@style/Text14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/textColor1"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/totalCharCount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="时空邮差.txt" />

            <TextView
                android:id="@+id/totalCharCount"
                style="@style/Text12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/textColor4"
                app:layout_constraintBottom_toTopOf="@id/errorTip"
                app:layout_constraintStart_toStartOf="@id/fileName"
                app:layout_constraintTop_toBottomOf="@id/fileName"
                tools:text="总计42.3万字" />

            <TextView
                android:id="@+id/errorTip"
                style="@style/Text13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/funcColorFailure"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/fileName"
                app:layout_constraintTop_toBottomOf="@id/totalCharCount"
                tools:text="发现23 处敏感词" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/confirm"
            style="@style/Button.Bold"
            android:layout_width="280dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spacing_l"
            android:background="@drawable/bg_theme_color1_r50"
            android:gravity="center"
            android:text="@string/reupload" />
    </LinearLayout>
</layout>
