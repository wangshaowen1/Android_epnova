<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.set.VideoSetViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/bgColor1">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:layout_constraintTop_toTopOf="parent"
            app:toolbar="@{layout.mToolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_m"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/Text14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/work_title"
                    android:textColor="?attr/textColor1"
                    android:textStyle="bold" />

                <com.kuaigeglobal.epnova.widget.CounterInputLayout
                    android:id="@+id/nameInputer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:background="@drawable/bg_fill_color_1_r8"
                    app:inputCounterGravity="right"
                    app:inputCounterRightMargin="0dp"
                    app:inputCounterTextColor="?attr/textColor4"
                    app:inputCounterTextSize="12sp"
                    app:inputCounterVisible="true"
                    app:inputHint="@string/name_your_creation"
                    app:inputHorizontalPadding="@dimen/spacing_m"
                    app:inputMaxLength="70"
                    app:inputMaxLines="1"
                    app:inputTextColor="?attr/textColor2"
                    app:inputTextColorHint="?attr/textColor4"
                    app:inputTextSize="14sp"
                    app:inputVerticalPadding="@dimen/spacing_m" />

                <TextView
                    style="@style/Text14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/create_same_story_synopsis"
                    android:textColor="?attr/textColor1"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/sameStoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:background="@drawable/bg_fill_color_1_r8"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/sameStoryContentScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_m"
                        android:paddingBottom="44dp"
                        android:scrollbars="none">

                        <TextView
                            android:id="@+id/sameStoryContent"
                            style="@style/Text14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:textColor="?attr/textColor2"
                            tools:text="@string/create_same_story_synopsis_hint" />
                    </androidx.core.widget.NestedScrollView>

                    <TextView
                        android:id="@+id/sameStoryLength"
                        style="@style/Text12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:layout_marginBottom="@dimen/spacing_m"
                        android:textColor="?attr/textColor4"
                        tools:text="0/500" />
                </FrameLayout>

                <TextView
                    style="@style/Text14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/total_episodes"
                    android:textColor="?attr/textColor1"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:adapter="@{layout.mEpisodeAdapterVm.MAdapter}"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_series_count" />

                <TextView
                    style="@style/Text14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/video_aspect_ratio"
                    android:textColor="?attr/textColor1"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/videoRatioRv"
                    setGridLayoutManager="@{2}"
                    setItemDecoration="@{layout.mRatioAdapterVm.MItemDecoration}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:adapter="@{layout.mRatioAdapterVm.MAdapter}"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_video_ratio" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        style="@style/Text14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/select_style"
                        android:textColor="?attr/textColor1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAllStyle"
                        style="@style/Text12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:drawableEnd="@drawable/arrow_right_gray48"
                        android:text="@string/view_all"
                        android:textColor="?attr/textColor4" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:adapter="@{layout.MStyleAdapterVm.MAdapter}"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_creation_style" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/bgColor1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingTop="10dp"
            android:paddingBottom="34dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnConfirm"
                style="@style/Button.Bold.Gradient"
                android:textStyle="normal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/start_creating" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
