<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.recharge.ItemRechargePaymentVM" />

        <import type="com.kuaigeglobal.epnova.R" />
    </data>

    <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
        backgroundColorAttr="@{item.isChecked ? R.attr.bgColor2 : R.attr.bgColor3}"
        showBorder="@{item.isChecked}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:onClick="@{(it)->item.onItemClick.invoke(it)}"
        app:borderCenterColor="@color/gradient_btn_center_dark"
        app:borderEndColor="@color/gradient_btn_end_dark"
        app:borderStartColor="@color/gradient_btn_start_dark"
        app:borderWidth="1.5dp"
        app:roundCornerRadius="12dp"
        tools:backgroundStartColor="?attr/bgColor2">

        <androidx.constraintlayout.widget.Placeholder
            android:id="@+id/scope"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="166:44"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPayment"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@{item.data.icon}"
            app:layout_constraintBottom_toBottomOf="@+id/scope"
            app:layout_constraintEnd_toStartOf="@+id/tvPayment"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/scope"
            app:layout_constraintTop_toTopOf="@+id/scope"
            tools:src="@drawable/icon_payment_wx" />

        <TextView
            android:id="@+id/tvPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@{item.data.name}"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor2"
            app:layout_constraintBottom_toBottomOf="@+id/scope"
            app:layout_constraintEnd_toEndOf="@+id/scope"
            app:layout_constraintStart_toEndOf="@+id/ivPayment"
            app:layout_constraintTop_toTopOf="@+id/scope"
            tools:text="微信" />
    </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>
</layout>
