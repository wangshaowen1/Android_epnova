<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.creator.storyboard.ItemStoryboardVM" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="@{@string/storyboard_s(item.no)}"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor4"
            app:layout_constraintBottom_toBottomOf="@+id/btnDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnDelete"
            tools:text="分镜2" />

        <ImageView
            android:id="@+id/btnDelete"
            singleClick="@{(v)->item.onItemClick.invoke(v)}"
            android:layout_width="36dp"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/icon_delete_text4_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.kuaigeglobal.epnova.widget.RecyclerEditText
            android:id="@+id/etStoryboardDesc"
            content="@{item.storyBoardDesc}"
            onTextInputListener="@{item.storyboardDescInputListener}"
            setEditing="@{item.editingStoryBoardDesc}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/fill_color1_r8"
            android:ellipsize="end"
            android:gravity="top"
            android:hint="@string/storyboard_prompt"
            android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
            android:maxHeight="264dp"
            android:maxLength="1000"
            android:minHeight="100dp"
            android:onClick="@{(v)->item.onItemClick.invoke(v)}"
            android:padding="12dp"
            android:textAppearance="@style/Text13"
            android:textColor="?attr/textColor2"
            android:textColorHint="?attr/textColor4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnDelete" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>