<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.rewards.ItemEarnRewardVM" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_1b191f_r16"
        android:padding="@dimen/spacing_m">

        <!-- 左侧图标：一次性任务优先用服务端 iconUrl，缺失时使用本地兜底图标。 -->
        <FrameLayout
            android:id="@+id/flIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivIcon"
                imageResource="@{item.iconRes}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_video_circle"
                android:visibility="@{item.hasRemoteIcon ? View.GONE : View.VISIBLE}" />

            <ImageView
                android:id="@+id/ivRemoteIcon"
                loadUri="@{item.iconUrl}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="@{item.hasRemoteIcon ? View.VISIBLE : View.GONE}" />
        </FrameLayout>

        <!-- 标题 + 描述 -->
        <LinearLayout
            android:id="@+id/llText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/flAction"
            app:layout_constraintStart_toEndOf="@id/flIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <TextView
                style="@style/Text.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{item.title}"
                android:textColor="?attr/textColor1"
                android:textSize="14sp"
                tools:text="@string/rewards_watch_ad" />

            <TextView
                style="@style/Text.Regular"
                highlightColor="@{`#FFCE2C`}"
                highlightKeyword="@{item.coinsTxt}"
                titleText="@{item.subtitleText}"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_50_fffafb"
                android:textSize="14sp"
                tools:text="@string/rewards_watch_video_earn_50" />
        </LinearLayout>

        <!-- 右侧按钮区域（3 个 view 叠在一起，通过 visibility 切换） -->
        <FrameLayout
            android:id="@+id/flAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 广告任务已完成（Claimed） -->
            <TextView
                android:id="@+id/tvDone"
                style="@style/Text.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/rewards_claimed"
                android:textColor="?attr/textColor5"
                android:visibility="@{!item.isLoginTask &amp;&amp; item.isDone ? View.VISIBLE : View.GONE}"
                tools:visibility="gone" />

            <!-- 登录/一次性任务：Claim 按钮 -->
            <Button
                android:id="@+id/btnClaim"
                style="@style/Button.Bold"
                singleClick="@{(v) -> item.onCheckIn()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/home_login_reward_claim"
                android:textSize="14sp"
                android:textStyle="normal"
                android:visibility="@{(item.isLoginTask || item.onceTask != null) ? View.VISIBLE : View.GONE}"
                tools:visibility="gone" />

            <!-- 广告任务：Watch / Watch(locked) -->
            <Button
                android:id="@+id/btnWatch"
                style="@style/Button.Bold"
                singleClick="@{(v) -> item.onWatch()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="@{item.isLocked ? 0.6f : 1.0f}"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/rewards_watch"
                android:textStyle="normal"
                android:visibility="@{!item.isLoginTask &amp;&amp; (item.isWatch || item.isLocked) ? View.VISIBLE : View.GONE}"
                tools:visibility="visible" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
