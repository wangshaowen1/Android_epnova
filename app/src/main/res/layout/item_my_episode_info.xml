<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.series.ItemSeriesEpisodeVM" />

        <import type="android.view.View" />

        <import type="com.kuaigeglobal.epnova.core.network.apis.entity.CreatorEpisodeInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="12dp"
        android:onClick="@{(v)->item.onClick()}">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCover"
            loadUri="@{item.data.workCoverUrl}"
            placeHolder="@{@drawable/img_default_cover_3_4}"
            setVisible="@{!item.data.notCreated}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:visibility="@{item.data.notCreated ? View.INVISIBLE : View.VISIBLE}"
            app:layout_constraintDimensionRatio="107:142"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundStyle_r8"
            tools:src="@drawable/img_default_cover_3_4" />

        <!--   已发布展示这个角标     -->
        <com.google.android.material.imageview.ShapeableImageView
            setVisible="@{item.data.isPassed()}"
            android:layout_width="32dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_my_creation_status"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundStyle_tl_r8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_60_000000_r8"
            setVisible="@{item.data.episodeIsCreating&amp;&amp;item.isView()}"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover">

            <com.airbnb.lottie.LottieAnimationView
                isVisibleWithAnimation="@{item.data.episodeIsCreating&amp;&amp;item.isView()}"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="@dimen/spacing_m"
                app:lottie_autoPlay="true"
                app:lottie_fileName="loading_star/loading_star.json"
                app:lottie_imageAssetsFolder="loading_star/images"
                app:lottie_loop="true"
                app:lottie_repeatMode="reverse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@{item.episodeStatusText()}"
                android:textAppearance="@style/Text12"
                android:textColor="@color/fixed_white_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="视频生成中..." />
        </LinearLayout>

        <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
            setVisible="@{item.data.notCreated}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:backgroundStartColor="?attr/fillColor1"
            app:borderStartColor="?attr/borderColor2"
            app:borderWidth="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:roundCornerRadius="@dimen/radius_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/icon_add"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/to_be_created"
                android:textAppearance="@style/Text12"
                android:textColor="?attr/textColor3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>

        <!--   已发布不展示这个角标     -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            backgroundRes="@{item.publishBadgeBackground()}"
            textColorRes="@{item.publishBadgeTextColor()}"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@{item.publishBadgeText()}"
            android:textAppearance="@style/Text10"
            android:visibility="@{(item.hasPublishBadge()&amp;&amp;item.isView()&amp;&amp;!item.data.notCreated&amp;&amp;!item.data.isPassed())?View.VISIBLE:View.GONE}"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@id/ivCover"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constrainedWidth="true"
            tools:text="In Review" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_60_000000_round"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/waiting_to_synthesize"
            android:textAppearance="@style/Text10"
            android:textColor="@color/func_special_dark"
            android:visibility="@{(item.data.waitingComposing&amp;&amp;item.isView()&amp;&amp;!item.hasPublishBadge())?View.VISIBLE:View.GONE}"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:text="@{item.formatDuration()}"
            android:textColor="?attr/textColor1"
            android:textSize="12sp"
            android:visibility="@{(item.data.isCompleted&amp;&amp;item.isView())?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/ivCover"
            app:layout_constraintEnd_toEndOf="@id/ivCover"
            tools:text="03:26" />
        
        <TextView
            setVisible="@{!item.data.episodeShowStatus() &amp;&amp; !item.data.isCompleted}"
            app:layout_constraintBottom_toBottomOf="@id/ivCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/shape_episode_status"
            style="@style/Text.Regular"
            android:textSize="12sp"
            textColorRes="@{item.episodeStatusTextColor()}"
            android:gravity="center"
            android:text="@{item.episodeStatusText()}"
            tools:text="Ready to Generate"
            tools:textColor="@color/color_ffce2c"
            android:paddingVertical="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        
        <ImageView
            app:layout_constraintTop_toTopOf="@id/ivCover"
            app:layout_constraintBottom_toBottomOf="@id/ivCover"
            app:layout_constraintStart_toStartOf="@id/ivCover"
            app:layout_constraintEnd_toEndOf="@id/ivCover"
            android:src="@drawable/icon_play_off"
            setVisible="@{item.data.isCompleted}"
            android:layout_width="30dp"
            android:layout_height="30dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_60_000000_r8"
            android:visibility="@{(!item.isView() &amp;&amp; item.deleteLocked &amp;&amp; !item.data.notCreated) ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{@string/episode_number_format(item.data.sortNo)}"
            android:textAppearance="@style/Text12"
            android:textColor="?textColor2"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toBottomOf="@+id/ivCover"
            tools:text="第几集" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:alpha="@{item.deleteLocked ? 0.5f : 1f}"
            android:importantForAccessibility="no"
            android:src="@{item.isSelected() ? @drawable/ic_my_creation_selected : @drawable/ic_my_creation_unselected}"
            android:visibility="@{item.isView()?View.GONE:View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="@id/ivCover"
            app:layout_constraintTop_toTopOf="@id/ivCover"
            tools:src="@drawable/ic_my_creation_selected" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
