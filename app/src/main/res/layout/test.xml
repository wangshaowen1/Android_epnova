<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        tools:ignore="HardcodedText">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/time"
                android:layout_width="54dp"
                android:layout_height="19dp"
                android:gravity="center"
                android:text="9:41"
                android:textColor="#F5FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="21dp"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:id="@+id/cellular"
                android:layout_width="17dp"
                android:layout_height="11dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@id/wifiText"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="5dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="4dp"
                    android:background="#F5FFFFFF" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="2dp"
                    android:background="#F5FFFFFF" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="2dp"
                    android:background="#F5FFFFFF" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="2dp"
                    android:background="#F5FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/wifiText"
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:gravity="center"
                android:text="Wi"
                android:textColor="#F5FFFFFF"
                android:textSize="8sp"
                app:layout_constraintEnd_toStartOf="@id/battery"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="5dp" />

            <FrameLayout
                android:id="@+id/battery"
                android:layout_width="24dp"
                android:layout_height="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="15dp">

                <View
                    android:layout_width="22dp"
                    android:layout_height="11dp"
                    android:layout_gravity="start|center_vertical"
                    android:alpha="0.4"
                    android:background="#F5FFFFFF" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="7dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="#F5FFFFFF" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="4dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="#F5FFFFFF" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="Settings"
                android:textColor="#F5FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/settingsCard"
            android:layout_width="0dp"
            android:layout_height="208dp"
            android:background="@drawable/fill_color1_r12"
            android:clipToOutline="true"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/llAutoUnlock"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_customer_service" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Auto unlock episode"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_toggle_on" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPrivacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_customer_service" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Privacy Policy"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right_gray36" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTermsOfService"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_customer_service" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Terms of Service"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right_gray36" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_customer_service" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Delete Account"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right_gray36" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnLogOut"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_06_ffffff_r100"
            android:gravity="center"
            android:text="Log Out"
            android:textColor="#FF544F"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/settingsCard"
            app:layout_constraintStart_toStartOf="@id/settingsCard"
            app:layout_constraintTop_toBottomOf="@id/settingsCard"
            android:layout_marginTop="32dp" />

        <View
            android:id="@+id/homeIndicator"
            android:layout_width="130dp"
            android:layout_height="6dp"
            android:layout_marginBottom="14dp"
            android:alpha="0.96"
            android:background="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
