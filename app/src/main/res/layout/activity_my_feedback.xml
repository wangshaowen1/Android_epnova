<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.settings.feedback.FeedbackViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVMDetail}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="vertical"
                android:paddingBottom="60dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        imageResource="@{layout.statusIconRes(layout.feedbackDetail)}"
                        tools:src="@drawable/ic_replied" />

                    <TextView
                        style="@style/Text20.Outfit.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@{layout.feedbackStatusText(layout.feedbackDetail)}"
                        textColorRes="@{layout.statusColorRes(layout.feedbackDetail)}"
                        tools:text="Replied" />
                </LinearLayout>

                <TextView
                    style="@style/Text14.Outfit.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/feedback_thanks"
                    android:textColor="?attr/textColor3" />

                <LinearLayout
                    android:id="@+id/ll_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_06_ffffff_r8"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feedback_type"
                            android:textColor="?attr/textColor4" />

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@{layout.feedbackTypeText(layout.feedbackDetail.problemType)}"
                            android:textColor="?attr/textColor2"
                            tools:text="Other Issues" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feedback_submitted_on"
                            android:textColor="?attr/textColor4" />

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@{layout.feedbackSubmittedTime(layout.feedbackDetail.createTime)}"
                            android:textColor="?attr/textColor2"
                            tools:text="2026/12/02 12:31:12" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text14.Outfit.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/feedback_description"
                        android:textColor="?attr/textColor4" />

                    <TextView
                        style="@style/Text14.Outfit.Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@{layout.feedbackDetail.problemDesc}"
                        android:textColor="?attr/textColor2"
                        tools:text="Can I make original video make upload to reels or TikTok to make Money……" />

                    <com.kuaigeglobal.epnova.widget.PhotoGridView
                        android:id="@+id/photo1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="4"
                        android:minHeight="70dp"
                        android:visibility="@{layout.hasFeedbackImages(layout.feedbackDetail) ? View.VISIBLE : View.GONE}"
                        app:add_button_visible="false"
                        app:child_height="70dp"
                        app:divider_space="12dp" />
                </LinearLayout>

                <TextView
                    android:gravity="center_horizontal"
                    style="@style/Text14.Outfit.Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/feedback_waiting_reply"
                    android:textColor="?attr/textColor4"
                    android:visibility="@{layout.hasReply(layout.feedbackDetail) ? View.GONE : View.VISIBLE}" />

                <LinearLayout
                    android:id="@+id/ll_customer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_06_ffffff_r8"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="@{layout.hasReply(layout.feedbackDetail) ? View.VISIBLE : View.GONE}">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/feedback_support_reply"
                            android:textColor="?attr/textColor2" />

                        <TextView
                            style="@style/Text14.Outfit.Regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{layout.feedbackReplyTime(layout.feedbackDetail.replyTime)}"
                            android:textColor="?attr/textColor4"
                            tools:text="Sep 3, 2026" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text14.Outfit.Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@{layout.feedbackReplyText(layout.feedbackDetail)}"
                        android:textColor="?attr/textColor2"
                        tools:text="Can I make original video make upload to reels or TikTok to make Money" />

                    <com.kuaigeglobal.epnova.widget.PhotoGridView
                        android:id="@+id/photo2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="4"
                        android:minHeight="70dp"
                        android:visibility="@{layout.hasReplyImages(layout.feedbackDetail) ? View.VISIBLE : View.GONE}"
                        app:add_button_visible="false"
                        app:child_height="70dp"
                        app:divider_space="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
