<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="6dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_popup_anchor" />

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_color3_r8"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:drawableStart="@drawable/icon_edit20"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/edit"
                android:textColor="?attr/textColor3" />

            <TextView
                android:id="@+id/btnManage"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:drawableStart="@drawable/ic_mine_settings"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/manage"
                android:textColor="?attr/textColor3" />

            <TextView
                android:id="@+id/btnDel"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:drawableStart="@drawable/icon_delete20"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/del"
                android:textColor="?attr/textColor3" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>