<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.recharge.MyBalanceViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20">

        <ImageView
            android:id="@+id/ivTopBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_coin_recharge_top"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:onClick="@{(v)->layout.dismiss()}"
            android:paddingHorizontal="15dp"
            android:src="@drawable/icon_close"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            hwRatio="@{layout.loadState == 3 ? 3f : 1f}"
            onRetry="@{layout::loadConfig}"
            setConstraintMaxHeightByWidth="@{true}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/banner"
                    banner="@{layout.workCourseBanner}"
                    layout="@layout/layout_common_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/tvPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner"
                    app:layout_goneMarginTop="0dp"
                    tools:text="Balance: 0">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/episode_unlock_popup_balance"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor3" />

                    <ImageView
                        android:id="@+id/ivBalanceIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="4dp"
                        android:src="@drawable/ic_coins" />

                    <TextView
                        android:id="@+id/tvBalanceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.displayBalance}"
                        android:textAppearance="@style/Text14"
                        android:textColor="?attr/textColor3"
                        tools:text="0" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRechargeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingTop="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tvPower"
                    app:spanCount="2"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_recharge_power" />

                <LinearLayout
                    android:id="@+id/llPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_l"
                    android:orientation="vertical"
                    android:paddingBottom="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount">

                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_s"
                        android:textColor="?attr/textColor3"
                        android:text="@string/store_tips_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="@dimen/lineSpacingExtraLarge"
                        tools:text="@string/store_tips_content_coins"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor4" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
