<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAnchor"
            android:layout_width="11dp"
            android:layout_height="6dp"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_popup_anchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.373626373626"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_color3_r8"
            android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
            android:padding="12dp"
            android:textAppearance="@style/Text12"
            android:textColor="?attr/textColor3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.795275590551"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivAnchor"
            app:layout_constraintWidth_percent="0.6613"
            tools:text="作品第3集中涉及色情、暴力等不良引导，请更正后再提交" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>