<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_white_rectangle_top_corner_r24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cancel"
            style="@style/Text.Common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="20dp"
            android:text="@string/cancel"
            android:textColor="@color/color_50_121212"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/choose_region"
            android:textSize="16sp"
            android:textColor="@color/textColorPrimary" />

        <TextView
            android:id="@+id/confirm"
            android:textSize="14sp"
            style="@style/Text.Common"
            android:paddingHorizontal="18dp"
            android:paddingVertical="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textColorPrimary"
            android:text="@string/confirm_ok" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@id/dataPicker"
            app:layout_constraintBottom_toBottomOf="@id/dataPicker"
            app:layout_constraintStart_toStartOf="@id/dataPicker"
            app:layout_constraintEnd_toEndOf="@id/dataPicker"
            android:background="@drawable/bg_wheel"
            android:layout_gravity="center"
            android:layout_marginBottom="6dp"
            />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <com.flqy.datepicker.NumberPicker
            android:id="@+id/wheel_province"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:internalLayout="@layout/data_picker_with_selector_wheel"
            app:selectionDividersDistance="46dp"
            app:internalMinWidth="176dp"/>

        <com.flqy.datepicker.NumberPicker
            android:id="@+id/wheel_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:internalLayout="@layout/data_picker_with_selector_wheel"
            app:selectionDividersDistance="46dp"
            app:internalMinWidth="176dp"/>
    </LinearLayout>
    </FrameLayout>

</LinearLayout>
