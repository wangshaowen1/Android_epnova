<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creation.CreationDramasViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_000215">

        <ImageView
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/bg_create_dramas_header"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintDimensionRatio="375:190"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_l"
            app:layout_constraintBottom_toTopOf="@id/tabs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constrainedWidth="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.kuaigeglobal.epnova.widget.GradientTextView
                android:textSize="24sp"
                android:fontFamily="@font/outfit_semibold"
                android:id="@+id/tvTitle"
                android:layout_marginBottom="10dp"
                app:endColor="#B065FF"
                app:middleColor="#B1F7FF"
                app:startColor="#FFFFFF"
                android:text="@string/create_dramas_with_ai"
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:textColor="?attr/textColor3"
                android:text="@string/creation_one_tap_hit_generation"
                style="@style/Text12.Outfit.Regular"
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_create_dramas_segment_container"
            android:padding="@dimen/spacing_xs"
            app:layout_constraintBottom_toBottomOf="@id/top">

            <View
                setHorizontalBias="@{layout.tabIndicatorPosition}"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_5a6afe_r54"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <androidx.legacy.widget.Space
                android:id="@+id/sLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <androidx.legacy.widget.Space
                android:id="@+id/sRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <TextView
                android:id="@+id/tabInspiration"
                android:layout_width="wrap_content"
                android:paddingHorizontal="40dp"
                android:layout_height="36dp"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:onClick="@{layout.clickHandler::onClick}"
                android:selected="@{layout.selectedTab == 0}"
                android:text="@string/creative_gen_inspiration"
                android:textColor="?attr/textColor1"
                android:alpha="@{layout.selectedTab==0?1f:0.7f}"
                style="@style/Text14.Outfit.Medium"
                app:layout_constraintEnd_toEndOf="@id/sLeft"
                app:layout_constraintStart_toStartOf="@id/sLeft"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tabNovel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:drawablePadding="4dp"
                android:paddingHorizontal="40dp"
                android:gravity="center"
                android:onClick="@{layout.clickHandler::onClick}"
                android:selected="@{layout.selectedTab == 1}"
                android:text="@string/novel_adapt"
                android:textColor="?attr/textColor1"
                android:alpha="@{layout.selectedTab==1?1f:0.7f}"
                style="@style/Text14.Outfit.Medium"
                app:layout_constraintEnd_toEndOf="@id/sRight"
                app:layout_constraintStart_toStartOf="@id/sRight"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>