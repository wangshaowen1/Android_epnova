<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.recharge.ItemRechargePowerVM" />

        <import type="com.kuaigeglobal.epnova.R" />
        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="@dimen/spacing_m">

        <com.kuaigeglobal.epnova.widget.BorderConstraintLayout
            backgroundColorAttr="@{item.isChecked ? R.attr.bgColor2 : R.attr.fillColor1}"
            showBorder="@{item.isChecked}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{(it)->item.onItemClick.invoke(it)}"
            app:borderCenterColor="?attr/themeColor1"
            app:borderStartColor="?attr/themeColor1"
            app:borderWidth="1.5dp"
            app:roundCornerRadius="12dp"
            tools:backgroundStartColor="?attr/bgColor2">

            <androidx.constraintlayout.widget.Placeholder
                android:id="@+id/scope"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="168:86"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivPower"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_coins"
                app:layout_constraintStart_toStartOf="@+id/scope"
                app:layout_constraintTop_toBottomOf="@id/llDiscount"
                app:layout_constraintVertical_chainStyle="spread" />

            <TextView
                android:id="@+id/tvPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/outfit_medium"
                android:text="@{item.data.coinsName}"
                android:textAppearance="@style/Text18"
                android:textColor="?attr/textColor1"
                app:layout_constraintBottom_toBottomOf="@+id/ivPower"
                app:layout_constraintStart_toEndOf="@+id/ivPower"
                app:layout_constraintTop_toTopOf="@+id/ivPower"
                tools:text="500" />

            <TextView
                android:id="@+id/tvGivePower"
                setVisible="@{item.data.discountValid}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false"
                android:text="@{`+`+item.data.giveCoinsNum}"
                android:textColor="?attr/textColor3"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/tvPower"
                app:layout_constraintStart_toEndOf="@id/tvPower"
                app:layout_constraintTop_toTopOf="@id/tvPower"
                tools:text="+200"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_regular"
                android:text="@{item.priceText}"
                android:textColor="?attr/textColor3"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@+id/ivPower"
                app:layout_constraintTop_toBottomOf="@id/ivPower"
                app:layout_constraintBottom_toBottomOf="@id/scope"
                tools:text="¥49.99" />

            <LinearLayout
                android:id="@+id/llDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_discount"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:visibility="@{item.data.discountValid?View.VISIBLE:View.INVISIBLE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_countdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="monospace"
                    android:text="@{item.discountText}"
                    android:textColor="@color/white"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    tools:text="23:59:59" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/color_40_ffffff" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="monospace"
                    android:text="@{item.data.coinsMarketingTag}"
                    android:textColor="@color/white"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    tools:text="+50%" />
            </LinearLayout>
        </com.kuaigeglobal.epnova.widget.BorderConstraintLayout>
    </FrameLayout>
</layout>
