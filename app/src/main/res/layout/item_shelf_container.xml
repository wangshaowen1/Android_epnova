<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvShelfTitle"
                style="@style/Text.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/textColor1"
                tools:text="New Release" />

            <TextView
                android:id="@+id/tvAll"
                style="@style/Text12.Outfit.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/arrow_right_gray36"
                android:drawablePadding="@dimen/spacing_xs"
                android:text="@string/all"
                android:textColor="?attr/textColor4" />
        </LinearLayout>

        <com.kuaigeglobal.epnova.widget.dragfooterview.ShelfDragConflictLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <com.kuaigeglobal.epnova.widget.dragfooterview.DragContainer
                android:id="@+id/dragContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                app:dc_drag_damp="0.6"
                app:dc_reset_animator_duration="300">

                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="178dp"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/ivShelfPullArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_left_16" />

                    <TextView
                        android:id="@+id/tvShelfPull"
                        style="@style/Text12.Outfit.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/pull_to_view_more"
                        android:textColor="?attr/textColor2" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInnerHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_book_shelf_child" />
            </com.kuaigeglobal.epnova.widget.dragfooterview.DragContainer>
        </com.kuaigeglobal.epnova.widget.dragfooterview.ShelfDragConflictLayout>
    </LinearLayout>
</layout>
