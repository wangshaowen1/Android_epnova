<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.home.search.SearchViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kuaigeglobal.epnova.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_size">

            <ImageView
                singleClick="@{(v)->layout.back()}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="@dimen/spacing_m"
                android:src="@drawable/icon_back_left" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="@drawable/bg_fill_color_2_r50"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_l">

                <EditText
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawableStart="@drawable/icon_search"
                    android:drawablePadding="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:hint="@string/home_search_placeholder"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="@={layout.keyWord}"
                    android:textColor="?attr/textColor2"
                    android:textColorHint="?attr/textColor4"
                    android:textSize="14sp" />

                <ImageView
                    singleClick="@{(v)->layout.clearKeyword()}"
                    setVisible="@{layout.keyWord.length()>0}"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/spacing_l"
                    android:src="@drawable/icon_delete_circle" />
            </LinearLayout>
        </FrameLayout>

        <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
            android:id="@+id/loadStateViewHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_m"
            setLoadState="@{layout.loadState}"
            app:noDataSrc="@drawable/img_default_search"
            app:noData="@string/home_search_no_results">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                setLinearLayoutManager="@{true}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:listitem="@layout/item_search_result" />
        </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
    </LinearLayout>
</layout>