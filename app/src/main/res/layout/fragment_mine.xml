<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.mine.MineViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <ImageView
            importantForAccessibility="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/bg_mine_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <com.kuaigeglobal.epnova.widget.StatusBarView
                android:id="@+id/sbv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/siv_avatar"
                    loadUri="@{layout.userInfo[`avatar`]}"
                    placeHolder="@{@drawable/ic_default_avatar}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/roundStyle_circle" />

                <TextView
                    android:id="@+id/tv_name"
                    android:textSize="18sp"
                    style="@style/Text.SemiBold"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:maxLines="1"
                    android:text="@{layout.userInfo[`nickname`]}"
                    android:textColor="@color/color_96_ffffff"
                    app:layout_constraintBottom_toTopOf="@id/tv_id"
                    app:layout_constraintStart_toEndOf="@id/siv_avatar"
                    app:layout_constraintTop_toTopOf="@id/siv_avatar"
                    tools:text="Duebass" />

                <LinearLayout
                    setVisible="@{layout.loginRewardsValid}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/tv_name"
                    app:layout_constraintStart_toStartOf="@id/tv_name">

                    <LinearLayout
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_theme_color1_r50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_coins"
                            android:layout_width="16dp"
                            android:layout_height="16dp"/>

                        <TextView
                            android:id="@+id/tv_floating_tip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            style="@style/Text.Regular"
                            android:textSize="12sp"
                            android:text="@{@string/login_claim_coins(layout.loginRewards)}"
                            android:textColor="?attr/textColor1"
                            tools:text="@string/login_claim_coins" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/ic_theme_arrow_down" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_arrow"
                    setVisible="@{!layout.isLogin()}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/icon_arrow_right"
                    app:layout_constraintBottom_toBottomOf="@id/tv_name"
                    app:layout_constraintStart_toEndOf="@id/tv_name"
                    app:layout_constraintTop_toTopOf="@id/tv_name" />


                <TextView
                    android:id="@+id/tv_id"
                    android:textSize="12sp"
                    style="@style/Text.Regular"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:text="@{`UID:`+layout.userInfo[`id`]}"
                    android:textColor="?attr/textColor4"
                    app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
                    app:layout_constraintStart_toStartOf="@id/tv_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_name"
                    tools:text="UID:10000" />

                <ImageView
                    android:id="@+id/iv_copy"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_copy"
                    app:layout_constraintBottom_toBottomOf="@id/tv_id"
                    app:layout_constraintStart_toEndOf="@id/tv_id"
                    app:layout_constraintTop_toTopOf="@id/tv_id" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginTop="@dimen/dp20"
                android:background="@drawable/bg_06_ffffff_r12"
                android:paddingBottom="13dp">

                <LinearLayout
                    android:id="@+id/ll_store"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:textSize="16sp"
                        style="@style/Text.Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/store_store"
                        android:textColor="@color/color_96_ffffff" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/border_color_2_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_store" />

                <TextView
                    android:id="@+id/tv_coins_data"
                    style="@style/Text.Medium"
                    android:textSize="20sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="13dp"
                    android:maxLines="1"
                    android:text="@{layout.coins}"
                    android:textColor="@color/color_96_ffffff"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:layout_constraintEnd_toStartOf="@+id/tv_credits_data"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider"
                    tools:text="0" />

                <ImageView
                    android:id="@+id/iv_coins"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_coins"
                    app:layout_constraintBottom_toBottomOf="@id/tv_coins"
                    app:layout_constraintStart_toStartOf="@id/tv_coins_data"
                    app:layout_constraintTop_toTopOf="@id/tv_coins" />

                <TextView
                    android:id="@+id/tv_coins"
                    style="@style/Text.Regular"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/newbie_coins"
                    android:textColor="?attr/textColor4"
                    app:layout_constraintStart_toEndOf="@id/iv_coins"
                    app:layout_constraintTop_toBottomOf="@id/tv_coins_data" />

                <ImageView
                    android:id="@+id/iv_coins_tooltip"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_attention"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_coins"
                    app:layout_constraintStart_toEndOf="@+id/tv_coins"
                    app:layout_constraintTop_toTopOf="@+id/tv_coins" />

                <TextView
                    android:id="@+id/tv_credits_data"
                    style="@style/Text.Medium"
                    android:textSize="20sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:maxLines="1"
                    android:text="@{layout.credits}"
                    android:textColor="@color/color_96_ffffff"
                    app:layout_constraintEnd_toStartOf="@id/tv_recharge"
                    app:layout_constraintStart_toStartOf="@id/iv_credits"
                    app:layout_constraintTop_toTopOf="@id/tv_coins_data"
                    tools:text="0" />

                <ImageView
                    android:id="@+id/iv_credits"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_power"
                    app:layout_constraintBottom_toBottomOf="@id/tv_credits"
                    app:layout_constraintStart_toEndOf="@id/iv_coins_tooltip"
                    app:layout_constraintTop_toTopOf="@id/tv_credits" />

                <TextView
                    android:id="@+id/tv_credits"
                    style="@style/Text.Regular"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_credits"
                    android:textColor="?attr/textColor4"
                    app:layout_constraintStart_toEndOf="@id/iv_credits"
                    app:layout_constraintTop_toBottomOf="@id/tv_credits_data" />

                <ImageView
                    android:id="@+id/iv_credits_tooltip"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_attention"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_credits"
                    app:layout_constraintStart_toEndOf="@+id/tv_credits"
                    app:layout_constraintTop_toTopOf="@+id/tv_credits" />

                <TextView
                    android:id="@+id/tv_recharge"
                    style="@style/Text.Medium"
                    android:textSize="14sp"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_theme_color1_r50"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/profile_recharge"
                    android:textColor="?attr/textColor1"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_credits"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_credits_data" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_06_ffffff_r12"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_income"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_mine_income" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:text="@string/profile_income"
                        android:textColor="@color/color_96_ffffff" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_rewards"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_mine_rewards" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:text="@string/rewards_title"
                        android:textColor="@color/color_96_ffffff" />

                    <TextView
                        android:id="@+id/tv_rewards_data"
                        style="@style/Text.Regular"
                        android:textSize="12sp"
                        setVisible="@{layout.unCheckNum>0}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_theme_color1_r50"
                        android:gravity="center"
                        android:minHeight="22dp"
                        android:paddingHorizontal="6dp"
                        android:text="@{`+`+layout.unCheckNum}"
                        android:textColor="?attr/textColor1"
                        tools:text="+1000" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_06_ffffff_r12"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_languages"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_mine_language" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:text="@string/settings_language"
                        android:textColor="@color/color_96_ffffff" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@{layout.language.name}"
                        android:textColor="?attr/textColor4"
                        tools:text="English" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_suggestions_feedback"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_mine_feedback" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:text="@string/profile_feedback_suggestions"
                        android:textColor="@color/color_96_ffffff" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_settings"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_mine_set" />

                    <TextView
                        style="@style/Text.Regular"
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:text="@string/title_settings"
                        android:textColor="@color/color_96_ffffff" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/arrow_right_gray36" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.kuaigeglobal.epnova.widget.MoveFrameLayout
            android:id="@+id/floating_ball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginBottom="14dp"
            android:padding="@dimen/spacing_m"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFloating"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/img_floating" />
        </com.kuaigeglobal.epnova.widget.MoveFrameLayout>
    </FrameLayout>
</layout>