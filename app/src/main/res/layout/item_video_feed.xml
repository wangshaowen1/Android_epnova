<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kuaigeglobal.epnova.feature.play.ItemVideoFeedVm" />

        <import type="android.view.View" />
    </data>

    <com.kuaigeglobal.epnova.widget.LoadStateViewHolder
        android:id="@+id/lsv"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            tools:background="@color/black">

            <com.kuaigeglobal.epnova.widget.CoverPlayerView
                android:id="@+id/playerView"
                track="@{item.data}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="?attr/bgColor1"
                android:onClick="@{() -> item.onClickBlankArea()}"
                android:saveEnabled="false"
                app:coverScaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,9:16"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="fit"
                app:shutter_background_color="?attr/bgColor1"
                app:use_controller="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="92dp"
                android:padding="3dp"
                android:shadowColor="@color/color_05_000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:textColor="?attr/textColor2"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/playerView"
                app:layout_constraintTop_toTopOf="@id/playerView"
                tools:background="@drawable/bg_90_ffffff_stroke_r3"
                tools:text="AI生成" />

            <TextView
                android:id="@+id/btnFullScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fill_color_1_stroke_r50"
                android:drawableStart="@drawable/icon_play_full"
                android:drawablePadding="5dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/full_screen"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.605" />

            <ImageView
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{() -> item.onClickPlay()}"
                android:src="@drawable/icon_play_off"
                android:visibility="@{item.showCenterPlayBtn ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <ImageView
                android:id="@+id/animBuffering"
                setVisible="@{item.showBuffering}"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/loading"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Text18"
                setVisible="@{!item.isHideViews()}"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:text="@{item.workInfo.workTitle}"
                android:textColor="?attr/textColor1"
                app:layout_constraintBottom_toTopOf="@id/tvContent"
                tools:text="代码纪元：觉醒指令" />

            <!--        android:onClick="@{(v)->item.onItemClick.invoke(v)}"-->
            <com.kuaigeglobal.epnova.widget.expandtextview.ExpandableTextView
                android:id="@+id/tvContent"
                expandContent="@{item.workInfo.workDesc}"
                setVisible="@{!item.isHideViews()}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="80dp"
                android:layout_marginBottom="95dp"
                android:lineSpacingExtra="@dimen/lineSpacingExtra"
                android:saveEnabled="false"
                android:textColor="?attr/textColor3"
                android:textSize="14dp"
                app:collapseLines="3"
                app:collapseTipLabel="@string/collapse"
                app:expandTipLabel="@string/expand"
                app:expandable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tipPosition="align_right"
                app:tipsColor="?attr/textColor2"
                app:tipsSize="14dp"
                tools:text="夏天是最美好的季节。阳光炽热而灿烂，天空湛夏天是最美好的季节。阳光炽热而灿烂，天空湛蓝如宝石。阳光炽热而灿而灿阳…"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/ll_interaction_side"
                setVisible="@{!item.isHideViews()}"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="134dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/llEpisodeSelect"
                app:layout_constraintEnd_toEndOf="parent"
                tools:background="@color/color_50_000000">

                <LinearLayout
                    android:id="@+id/btn_favorite"
                    singleClick="@{() -> item.onClickCollect()}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_collect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@{item.isCollected ? @drawable/icon_play_collection1 : @drawable/icon_play_collection0}"
                        tools:src="@drawable/icon_play_collection0" />

                    <TextView
                        android:id="@+id/tv_collect_count"
                        style="@style/Text12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxWidth="40dp"
                        android:maxLines="1"
                        android:shadowColor="@color/color_05_000000"
                        android:shadowRadius="2"
                        android:text="@{item.collectCount}"
                        android:textColor="?attr/textColor1"
                        tools:text="998" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_like"
                    singleClick="@{() -> item.onClickLike()}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@{item.isLiked ? @drawable/icon_play_like1 : @drawable/icon_play_like0}"
                        tools:src="@drawable/icon_play_like0" />

                    <TextView
                        android:id="@+id/tv_like_count"
                        style="@style/Text12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxWidth="40dp"
                        android:maxLines="1"
                        android:shadowColor="@color/color_05_000000"
                        android:shadowRadius="2"
                        android:text="@{item.likeCount}"
                        android:textColor="?attr/textColor1"
                        tools:text="968.1k" />
                </LinearLayout>

            </LinearLayout>

            <com.kuaigeglobal.epnova.widget.PlayerSeekbar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                app:layout_constraintBottom_toTopOf="@id/llEpisodeSelect"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/llEpisodeSelect"
                singleClick="@{() -> item.onClickEpisodeSelect()}"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginBottom="@dimen/spacing_l"
                android:background="@drawable/fill_color1_r16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_episode_list"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="选集"
                    android:src="@drawable/icon_play_episode" />

                <TextView
                    style="@style/Text12"
                    text="@{`EP.`+item.data.sortNo}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:textColor="?attr/textColor2"
                    tools:text="EP.1" />

                <TextView
                    style="@style/Text12"
                    text="@{`/EP.`+item.workInfo.totalEpisodeCnt}"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/textColor4"
                    tools:text="/EP.64" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="全屏"
                    android:src="@drawable/icon_up" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.kuaigeglobal.epnova.widget.LoadStateViewHolder>
</layout>
