<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.ViewAnimator">

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:id="@+id/loading_top_space"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="230" />


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loadingView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.5"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_fileName="loading_point/loading_point.json"
            app:lottie_imageAssetsFolder="loading_point/images"
            app:lottie_repeatMode="reverse" />

        <TextView
            android:id="@+id/loadingText"
            style="@style/Text14.Outfit.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/page_loading"
            android:textColor="?attr/textColor4" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="344" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/retryLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:id="@+id/retry_top_space"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="230" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/icon_state_network_error" />

        <TextView
            style="@style/Text16.Outfit.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/network_error"
            android:textColor="?attr/textColor2" />

        <TextView
            android:id="@+id/error_prompt_view"
            style="@style/Text14.Outfit.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@string/page_network_error"
            android:textColor="?attr/textColor4" />

        <TextView
            android:id="@+id/retry_btn"
            style="@style/Button.Bold"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_theme1_r50"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:text="@string/refresh_to_retry"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="344" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:id="@+id/empty_top_space"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="230" />

        <ImageView
            android:id="@+id/no_data_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/icon_state_no_data" />

        <TextView
            android:id="@+id/no_data"
            style="@style/Text14.Outfit.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@string/page_empty"
            android:textColor="?attr/textColor4" />

        <TextView
            android:id="@+id/no_data_btn"
            style="@style/Text14.Outfit.Regular"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_theme1_r50"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:text="@string/refresh_to_retry"
            android:textColor="@color/white"
            android:visibility="gone" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="344" />
    </LinearLayout>
</merge>
