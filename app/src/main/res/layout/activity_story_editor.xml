<?xml version="1.0" encoding="utf-8"?><!--选择话题-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.generate.StoryEditorViewModel" />

        <import type="android.view.View" />

        <import type="com.kuaigeglobal.epnova.common.utils.Utils" />

        <import type="com.kuaigeglobal.epnova.feature.creator.data.DramaGenerateConstants" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kuaigeglobal.epnova.widget.StatusBarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnClose"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/statusBar" />

            <TextView
                android:id="@+id/tvWorkName"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:text="@{layout.title}"
                android:textColor="?attr/textColor3"
                android:textColorHint="?attr/textColor4"
                android:textSize="16sp"
                tools:text="代码纪元：觉醒指令..." />

            <ImageView
                android:id="@+id/btnModify"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_edit_full_gray"
                android:visibility="@{(layout.step&lt;=1||(layout.step==2&amp;&amp;layout.model==DramaGenerateConstants.MODEL_STORY))?View.VISIBLE:View.GONE}" />

            <androidx.legacy.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnModels"
                setVisible="@{layout.showModels(layout.step)&amp;&amp;layout.currentCreationModel!=null&amp;&amp;layout.dramaCategoryPopupEnabled}"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_l"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:background="@drawable/fill_color2_stroke_r8"
                android:drawableEnd="@drawable/icon_arrow_down"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/spacing_s"
                android:text="@{layout.currentCreationModel.configName}"
                android:textColor="?attr/textColor1"
                android:textSize="14sp"
                tools:text="解说漫模型" />
        </LinearLayout>

        <include
            layout="@layout/layout_story_board_header"
            app:startFrom="@{layout.startFrom}"
            app:step="@{layout.step}" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</layout>
