<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.creator.StoryUploadViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_2a2a2b_r24"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            style="@style/Text16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/upload_completed_novel"
            android:textColor="?attr/textColor1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:background="@drawable/shape_bg_story_upload"
            android:gravity="center"
            android:minWidth="253dp"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@{layout.getImageIcon(layout.uploadStatus)}"
                android:visibility="@{layout.uploadStatus!=1?View.VISIBLE:View.GONE}"
                tools:src="@drawable/img_text_upload" />

            <ImageView
                rotateLoading="@{layout.uploadStatus==1}"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="10dp"
                android:src="@drawable/icon_loading2" />

            <TextView
                style="@style/Text14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.uploadProgress}"
                android:textColor="?attr/textColor2"
                android:visibility="@{layout.uploadStatus==1?View.VISIBLE:View.GONE}"
                tools:text="99.9%" />

            <TextView
                style="@style/Text14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.fileName}"
                android:textColor="?attr/textColor2"
                android:visibility="@{layout.uploadStatus==2?View.VISIBLE:View.GONE}"
                tools:text="小说名称" />

            <TextView
                style="@style/Text14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.uploadErrorType==1?layout.limitErrorText:@string/upload_failed}"
                android:textColor="?attr/funcColorFailure"
                android:visibility="@{layout.uploadStatus==3?View.VISIBLE:View.GONE}"
                tools:text="字数不符合要求，需调整后重新上传" />

            <TextView
                android:id="@+id/btnChoose"
                style="@style/Text14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.uploadStatus == 0 ? @string/file_picker_click : @string/reselect}"
                android:textColor="?attr/themeColor2"
                android:textStyle="bold"
                android:visibility="@{layout.uploadStatus==1?View.GONE:View.VISIBLE}"
                tools:text="点击上传文件" />

            <TextView
                style="@style/Text12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@{layout.limitText}"
                android:textColor="?attr/textColor3"
                android:textStyle="bold"
                tools:text="仅支持txt文本，限制10万-60万字" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/text_sensitive_warning"
            android:textColor="?attr/textColor4"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel"
                style="@style/Text16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/spacing_m"
                android:layout_weight="1"
                android:background="@drawable/btn_common_cancel"
                android:gravity="center"
                android:text="@string/cancellation"
                android:textColor="?attr/textColor2" />

            <Button
                android:id="@+id/confirm"
                style="@style/Text16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="@{layout.uploadStatus==2?1.0f:0.6f}"
                android:background="@drawable/bg_theme_color1_r50"
                android:enabled="@{layout.uploadStatus==2}"
                android:gravity="center"
                android:text="@string/upload"
                android:textColor="?attr/textColor1" />
        </LinearLayout>
    </LinearLayout>
</layout>
