<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text16"
            setTextBold="@{true}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/edit_title"
            android:textColor="?attr/textColor1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Text14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/story_title"
            android:textColor="?attr/textColor1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.kuaigeglobal.epnova.widget.CounterInputLayout
            android:id="@+id/nameInputer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            app:inputBackground="@drawable/bg_fill_color_1_r8"
            app:inputCounterGravity="right"
            app:inputCounterRightMargin="0dp"
            app:inputCounterTextColor="?attr/textColor4"
            app:inputCounterTextSize="12sp"
            app:inputCounterVisible="true"
            app:inputHorizontalPadding="@dimen/spacing_m"
            app:inputTextColor="?attr/textColor2"
            app:inputTextColorHint="?attr/textColor4"
            app:inputTextSize="14sp"
            app:inputVerticalPadding="@dimen/spacing_m"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:inputMaxLength="20" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/spacing_l"
            android:padding="3dp"
            android:src="@drawable/icon_close"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="120dp"
            android:layout_marginBottom="30dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameInputer">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Button.Bold.Cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btnConfirm"
                style="@style/Button.Bold"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_weight="1"
                android:text="@string/confirm_ok" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>