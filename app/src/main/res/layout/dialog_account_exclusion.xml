<?xml version="1.0" encoding="utf-8"?><!--支付协议弹窗-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ffffff_r25"
    android:paddingHorizontal="15dp"
    android:paddingTop="30dp"
    android:paddingBottom="13dp">


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="23dp"
        tools:text="你的微信已与另一台设备关联，如果需关联此设备，需解绑已绑定的设备，再登录此设备"
        android:textColor="@color/color_121212"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_marginTop="27dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_not_registered_member_benefits_cancel"
        app:layout_constraintEnd_toStartOf="@id/iv_untie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <ImageView
        android:id="@+id/iv_untie"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_i_got_it"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_cancel"
        app:layout_constraintTop_toTopOf="@id/iv_cancel" />
</androidx.constraintlayout.widget.ConstraintLayout>
