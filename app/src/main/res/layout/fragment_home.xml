<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.home.HomeTabsViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <com.kuaigeglobal.epnova.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_s"
            android:background="@drawable/bg_fill_color_2_r50"
            android:drawableStart="@drawable/icon_search"
            android:drawablePadding="@dimen/spacing_s"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="9dp"
            android:text="@string/home_search_placeholder"
            android:textColor="@color/color_30_ffffff"
            android:textSize="14sp"
            style="@style/Text.Regular"
            app:layout_constraintEnd_toStartOf="@id/btnRewards"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />

        <ImageView
            android:id="@+id/btnRewards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_xs"
            android:src="@drawable/icon_rewards100"
            app:layout_constraintBottom_toBottomOf="@id/btnSearch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnSearch" />

        <TextView
            android:id="@+id/tvRewards"
            setVisible="@{layout.unCheckNum>0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_theme_color1_r50"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:text="@{`+`+layout.unCheckNum}"
            android:textColor="@color/white"
            android:textSize="10sp"
            style="@style/Text.Regular"
            android:translationX="8dp"
            android:translationY="-4dp"
            app:layout_constraintEnd_toEndOf="@id/btnRewards"
            app:layout_constraintStart_toStartOf="@id/btnRewards"
            app:layout_constraintTop_toTopOf="@id/btnRewards" />

        <com.nhsd.magicindicator.MagicIndicator
            android:id="@+id/magic_indicator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_size"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintTop_toBottomOf="@id/btnSearch" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/magic_indicator" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
