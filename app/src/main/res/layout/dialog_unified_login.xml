<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kuaigeglobal.epnova.feature.login.unified.UnifiedLoginViewModel" />

        <import type="android.view.View" />

        <import type="android.text.method.LinkMovementMethod" />

        <import type="com.kuaigeglobal.epnova.common.utils.DebugUtils" />

        <import type="com.kuaigeglobal.epnova.common.Constant.SDKConfiguration" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bt_settings"
                style="@style/Button.Menu"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_marginStart="15dp"
                android:text="@string/title_settings"
                android:visibility="@{DebugUtils.INSTANCE.isDebug()?View.VISIBLE:View.GONE}"
                app:layout_constraintBottom_toBottomOf="@id/btnClose"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnClose" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_kuaichupian"
                android:textColor="?attr/textColor1"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:id="@+id/btnClose"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_s"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/btnWechat"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_07c160_r50"
            android:gravity="center"
            android:visibility="@{SDKConfiguration.IS_SHOW_WE_CHAT?View.VISIBLE:View.GONE}"
            tools:visibility="visible">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_login_wechat" />

            <TextView
                style="@style/Text16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/spacing_m"
                android:text="@string/wechat_login"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPhone"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/gradient_button_bg_r50"
            android:gravity="center">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_phone" />

            <TextView
                style="@style/Text16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/spacing_m"
                android:text="@string/mobile_login"
                android:textColor="?attr/textColor1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_describe"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/btnPhone">

            <ImageView
                android:id="@+id/ivCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@{layout.checkedPolicy?@drawable/icon_choose_checked:@drawable/icon_choose_normal_dark}"
                tools:src="@drawable/icon_choose_checked" />

            <TextView
                android:id="@+id/tv_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:lineSpacingExtra="@dimen/lineSpacingExtra"
                android:textColor="?attr/textColor3"
                android:textColorHighlight="@android:color/transparent"
                android:textSize="12sp"
                tools:text="我已阅读并同意《用户协议》、《隐私政策》" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />
    </LinearLayout>
</layout>