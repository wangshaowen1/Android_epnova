<?xml version="1.0" encoding="utf-8"?>
<com.kuaigeglobal.epnova.widget.GridImageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:gridImageColumnCount="2"
    app:gridImageMaxRowCount="3"
    app:gridImageCellSize="40dp"
    app:gridImageSingleColumnSize="64dp"
    app:gridImageDoubleColumnSize="40dp"
    app:gridImageMultiColumnSize="@dimen/spacing_xl"
    app:gridImageSizeMode="original"
    app:gridImageHorizontalSpacing="6.75dp"
    app:gridImageVerticalSpacing="@dimen/spacing_s"
    app:gridImageSingleMaxWidth="120dp"
    app:gridImageSingleMaxHeight="120dp"
    app:gridImageSingleWidth="72dp"
    app:gridImageSingleHeight="48dp"
    app:gridImageSingleMinWidth="@dimen/spacing_l"
    app:gridImageSingleMinHeight="@dimen/spacing_l"
    app:gridImageMirrorInRtl="true"
    app:gridImageMaxDecodeEdge="2048"
    app:gridImagePreviewEnabled="false"
    app:gridImageCornerRadius="@dimen/radius_s"
    app:gridImagePlaceholder="@drawable/img_default_cover_1_1" />
